<Window x:Class="WinShare.App.Views.Shares.ShareCreateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Title="新建共享" Background="{DynamicResource BrushCard}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 协议（TS Form.Item protocol：NFS 客户端系统禁用、无 IIS 禁 FTP/WebDAV） -->
            <TextBlock Text="协议" FontSize="12" Margin="0,0,0,4" />
            <ComboBox x:Name="CmbProtocol" FontSize="13" Margin="0,0,0,12"
                      SelectionChanged="OnProtocolChanged">
                <ComboBoxItem Content="SMB（Windows 文件共享）" Tag="smb" />
                <ComboBoxItem x:Name="OptNfs" Content="NFS（网络文件系统）" Tag="nfs" />
                <ComboBoxItem x:Name="OptFtp" Content="FTP（IIS FTP 站点）" Tag="ftp" />
                <ComboBoxItem x:Name="OptWebdav" Content="WebDAV（IIS WebDAV 站点）" Tag="webdav" />
            </ComboBox>

            <!-- 常见场景预设（TS 场景预设按钮组；填入后仍可逐项调整） -->
            <TextBlock Text="常见预设" FontSize="12" Margin="0,0,0,4"
                       ToolTip="一键填入该场景常用参数，填入后仍可逐项调整" />
            <StackPanel x:Name="ScenarioPanel" Margin="0,0,0,12" />

            <!-- 共享名（TS name：必填；手改后路径变化不再自动带名） -->
            <TextBlock Text="共享名" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="TxtName" FontSize="13" Margin="0,0,0,12"
                     TextChanged="OnNameChanged" Text="SharedDocs" />

            <!-- 本地路径（TS path：必填；浏览/拖拽/手输都会带出共享名；1 列纵向流） -->
            <TextBlock Text="本地路径" FontSize="12" Margin="0,0,0,4" />
            <StackPanel Margin="0,0,0,12">
                <TextBox x:Name="TxtPath" FontSize="13" Text="D:\Share" TextChanged="OnPathChanged" />
                <Button x:Name="BtnBrowse" Content="浏览" HorizontalAlignment="Left"
                        Padding="8,2" Margin="0,4,0,0" Click="OnBrowse" />
            </StackPanel>

            <!-- 描述 -->
            <TextBlock Text="描述" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="TxtDescription" FontSize="13" Margin="0,0,0,12" />

            <!-- ===== SMB 专有（TS protocol==='smb' 字段组） ===== -->
            <StackPanel x:Name="BlockSmb" Visibility="Collapsed">
                <TextBlock Text="权限模板（可选）" FontSize="12" Margin="0,0,0,4" />
                <ComboBox x:Name="CmbPreset" FontSize="13" Margin="0,0,0,8" />

                <TextBlock x:Name="LblEncrypted" Text="启用 SMB 加密（新手模式隐藏）" FontSize="12"
                           Margin="0,0,0,4" />
                <CheckBox x:Name="ChkEncrypted" Margin="0,0,0,8" />

                <!-- 访问控制（TS 折叠面板：全/改/读/拒 四档，逗号分隔账号名；组账号带「组」标记） -->
                <TextBlock Text="访问控制（可选，不选则使用默认权限；账号名逗号分隔）" FontSize="12"
                           Margin="0,0,0,4" />
                <TextBlock Text="完全控制（FullAccess）" FontSize="11" Foreground="{DynamicResource BrushFog}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFull" FontSize="13" Margin="0,0,0,8" />
                <TextBlock Text="更改（ChangeAccess）" FontSize="11" Foreground="{DynamicResource BrushFog}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtChange" FontSize="13" Margin="0,0,0,8" />
                <TextBlock Text="读取（ReadAccess）" FontSize="11" Foreground="{DynamicResource BrushFog}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtRead" FontSize="13" Margin="0,0,0,8" />
                <TextBlock Text="拒绝（NoAccess，显式拒绝项）" FontSize="11" Foreground="{DynamicResource BrushFog}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtNoAccess" FontSize="13" Margin="0,0,0,8" />
                <TextBlock x:Name="LblCandidates" FontSize="11" Foreground="{DynamicResource BrushFog}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />

                <!-- 高级选项（新手模式整体收敛：不渲染不提交） -->
                <Expander x:Name="ExpAdvanced" Header="高级选项" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="ChkEncryptData" Content="共享级数据加密" Margin="0,0,0,4" />
                        <CheckBox x:Name="ChkShadowCopy" Content="卷影副本" Margin="0,0,0,4" />
                        <TextBlock Text="文件夹枚举模式" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbFem" FontSize="13" Margin="0,0,0,8">
                            <ComboBoxItem Content="无限制（可见全部子项）" Tag="Unrestricted" />
                            <ComboBoxItem Content="基于访问（仅可见有权限的子项）" Tag="AccessBased" />
                        </ComboBox>
                        <TextBlock Text="脱机缓存模式" FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbCaching" FontSize="13" Margin="0,0,0,8">
                            <ComboBoxItem Content="无" Tag="None" />
                            <ComboBoxItem Content="手动" Tag="Manual" />
                            <ComboBoxItem Content="文档" Tag="Documents" />
                            <ComboBoxItem Content="程序" Tag="Programs" />
                            <ComboBoxItem Content="BranchCache" Tag="BranchCache" />
                        </ComboBox>
                        <TextBlock Text="并发用户上限（0=无限制）" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtConcurrentLimit" FontSize="13" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- ===== NFS 专有 ===== -->
            <StackPanel x:Name="BlockNfs" Visibility="Collapsed">
                <TextBlock Text="认证方式" FontSize="12" Margin="0,0,0,4" />
                <StackPanel x:Name="NfsAuthPanel" Margin="0,0,0,8" />
                <TextBlock Text="默认访问权限" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadNfsRw" GroupName="NfsPerm" Content="读写" IsChecked="True" Margin="0,0,0,6"
                                 Checked="OnNfsPermChanged" />
                    <RadioButton x:Name="RadNfsRo" GroupName="NfsPerm" Content="只读" Checked="OnNfsPermChanged" />
                </StackPanel>
                <StackPanel x:Name="NfsAdvancedPanel" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkUnmapped" Content="启用未映射用户访问" Margin="0,0,0,4" />
                    <CheckBox x:Name="ChkAllowRoot" Content="允许 root 访问" Margin="0,0,0,4" />
                    <TextBlock Text="匿名 UID（0=默认）" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAnonUid" FontSize="13" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    <TextBlock Text="匿名 GID（0=默认）" FontSize="12" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAnonGid" FontSize="13" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- ===== FTP 专有 ===== -->
            <StackPanel x:Name="BlockFtp" Visibility="Collapsed">
                <TextBlock Text="端口" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFtpPort" FontSize="13" Width="120" HorizontalAlignment="Left"
                         Text="21" Margin="0,0,0,8" />
                <TextBlock Text="SSL 策略" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadFtpSslAllow" GroupName="Ssl" Content="允许" IsChecked="True" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpSslRequire" GroupName="Ssl" Content="要求" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpSslCred" GroupName="Ssl" Content="要求凭据" />
                </StackPanel>
                <TextBlock Text="认证模式" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadFtpAnon" GroupName="Auth" Content="匿名" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpBasic" GroupName="Auth" Content="基本" IsChecked="True" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpWin" GroupName="Auth" Content="Windows" />
                </StackPanel>
            </StackPanel>

            <!-- ===== WebDAV 专有 ===== -->
            <StackPanel x:Name="BlockWebdav" Visibility="Collapsed">
                <TextBlock Text="端口" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="TxtWdavPort" FontSize="13" Width="120" HorizontalAlignment="Left"
                         Text="80" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkWdavAnon" Content="启用匿名访问" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock x:Name="LblError" FontSize="12" Foreground="#FF4D4F"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Click="OnCancel" Padding="14,5" FontSize="13" Margin="0,0,8,0" />
            <Button Content="创建" Click="OnCreate" Padding="14,5" FontSize="13" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
