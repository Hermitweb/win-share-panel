<Window x:Class="WinShare.App.Views.Shares.ShareCreateWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Title="新建共享" Background="{DynamicResource BrushCard}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- v2.2.0 第二轮修复：表单字段多（协议/预设/访问控制 4 框/高级区），内容曾超出屏幕高度——
             标题栏被顶出屏外、底部按钮被裁切（用户报告「布局重叠/混乱」）。
             内容区包 ScrollViewer 限高，窗口高度上限 760（含边距 < 820 屏），任何屏幕都放得下。 -->
        <ScrollViewer Grid.Row="0" MaxHeight="660" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
            <!-- 协议（TS Form.Item protocol：NFS 客户端系统禁用、无 IIS 禁 FTP/WebDAV） -->
            <TextBlock Foreground="{DynamicResource BrushFog}" Text="协议" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
            <ComboBox x:Name="CmbProtocol" Style="{DynamicResource ComboBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,12"
                      SelectionChanged="OnProtocolChanged"
                      ToolTip="SMB：Windows 文件共享　NFS：网络文件系统　FTP / WebDAV：IIS 站点">
                <ComboBoxItem Content="SMB" Tag="smb" />
                <ComboBoxItem x:Name="OptNfs" Content="NFS" Tag="nfs" />
                <ComboBoxItem x:Name="OptFtp" Content="FTP" Tag="ftp" />
                <ComboBoxItem x:Name="OptWebdav" Content="WebDAV" Tag="webdav" />
            </ComboBox>

            <!-- 常见场景预设（TS 场景预设按钮组；填入后仍可逐项调整） -->
            <TextBlock Foreground="{DynamicResource BrushFog}" Text="常见预设" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4"
                       ToolTip="一键填入该场景常用参数，填入后仍可逐项调整" />
            <StackPanel x:Name="ScenarioPanel" Margin="0,0,0,12" />

            <!-- 共享名（TS name：必填；手改后路径变化不再自动带名；真实默认由建议路径/SharedDocs 兜底生成） -->
            <TextBlock Foreground="{DynamicResource BrushFog}" Text="共享名" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
            <TextBox x:Name="TxtName" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,12"
                     TextChanged="OnNameChanged" />

            <!-- 本地路径（TS path：必填；浏览/拖拽/手输都会带出共享名；1 列纵向流） -->
            <TextBlock Foreground="{DynamicResource BrushFog}" Text="本地路径" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtPath" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}"
                         TextChanged="OnPathChanged" Margin="0,0,8,0" />
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览…" Style="{DynamicResource RowActionButton}"
                        VerticalAlignment="Center" MinWidth="56" Click="OnBrowse" ToolTip="选择要共享的本地文件夹" />
            </Grid>

            <!-- 描述 -->
            <TextBlock Foreground="{DynamicResource BrushFog}" Text="描述" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
            <TextBox x:Name="TxtDescription" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,12"
                     ToolTip="可选备注，如「财务共享」" />

            <!-- ===== SMB 专有（TS protocol==='smb' 字段组） ===== -->
            <StackPanel x:Name="BlockSmb" Visibility="Collapsed">


                <TextBlock x:Name="LblEncrypted" Text="启用 SMB 加密" FontSize="{DynamicResource FontSizeSecondary}"
                           Margin="0,0,0,4" />
                <CheckBox x:Name="ChkEncrypted" Style="{DynamicResource CheckBoxSoft}" Margin="0,0,0,8" />

                <!-- 访问控制（v2.2.0：手输框升级为可下拉选择账号（本地用户+组），也保留逗号分隔手输） -->
                <TextBlock Foreground="{DynamicResource BrushFog}" Text="访问控制（可选）" FontSize="{DynamicResource FontSizeSecondary}"
                           ToolTip="不选则使用默认权限；可下拉选择账号，也可用逗号分隔输入多个账号。"
                           Margin="0,0,0,4" />
                <!-- v2.2.0 第四轮：2x2 栅格（纵排 4 行占高，内容排版失衡） -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="完全控制（FullAccess）" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TxtFull" Style="{DynamicResource ComboBoxSoft}" IsEditable="True" FontSize="{DynamicResource FontSizeBody}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock Text="更改（ChangeAccess）" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TxtChange" Style="{DynamicResource ComboBoxSoft}" IsEditable="True" FontSize="{DynamicResource FontSizeBody}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                        <TextBlock Text="读取（ReadAccess）" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushText}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TxtRead" Style="{DynamicResource ComboBoxSoft}" IsEditable="True" FontSize="{DynamicResource FontSizeBody}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <TextBlock Text="拒绝（NoAccess）" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushText}"
                                   ToolTip="显式拒绝项：优先于其他权限" Margin="0,0,0,4" />
                        <ComboBox x:Name="TxtNoAccess" Style="{DynamicResource ComboBoxSoft}" IsEditable="True" FontSize="{DynamicResource FontSizeBody}" />
                    </StackPanel>
                </Grid>
                <!-- v2.2.0 第二轮：权限模板紧邻访问控制（同一权限语义块） -->
                <TextBlock Text="权限模板（可选）" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,8,0,4" />
                <ComboBox x:Name="CmbPreset" Style="{DynamicResource ComboBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,8"
                          ToolTip="套用已保存的权限模板（可稍后逐项调整）" />

                <!-- 高级选项（新手模式整体收敛：不渲染不提交） -->
                <Expander x:Name="ExpAdvanced" Header="高级选项" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="ChkEncryptData" Content="共享级数据加密" Style="{DynamicResource CheckBoxSoft}" Margin="0,0,0,4" />
                        <CheckBox x:Name="ChkShadowCopy" Content="卷影副本" Style="{DynamicResource CheckBoxSoft}" Margin="0,0,0,4" />
                        <TextBlock Text="文件夹枚举模式" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbFem" Style="{DynamicResource ComboBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,8">
                            <ComboBoxItem Content="无限制（可见全部子项）" Tag="Unrestricted" />
                            <ComboBoxItem Content="基于访问（仅可见有权限的子项）" Tag="AccessBased" />
                        </ComboBox>
                        <TextBlock Text="脱机缓存模式" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                        <ComboBox x:Name="CmbCaching" Style="{DynamicResource ComboBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Margin="0,0,0,8">
                            <ComboBoxItem Content="无" Tag="None" />
                            <ComboBoxItem Content="手动" Tag="Manual" />
                            <ComboBoxItem Content="文档" Tag="Documents" />
                            <ComboBoxItem Content="程序" Tag="Programs" />
                            <ComboBoxItem Content="BranchCache" Tag="BranchCache" />
                        </ComboBox>
                        <TextBlock Text="并发用户上限（0=无限制）" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtConcurrentLimit" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Width="120" HorizontalAlignment="Left" />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- ===== NFS 专有 ===== -->
            <StackPanel x:Name="BlockNfs" Visibility="Collapsed">
                <TextBlock Text="认证方式" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <StackPanel x:Name="NfsAuthPanel" Margin="0,0,0,8" />
                <TextBlock Text="默认访问权限" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadNfsRw" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="NfsPerm" Content="读写" IsChecked="True" Margin="0,0,0,6"
                                 Checked="OnNfsPermChanged" />
                    <RadioButton x:Name="RadNfsRo" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="NfsPerm" Content="只读" Checked="OnNfsPermChanged" />
                </StackPanel>
                <StackPanel x:Name="NfsAdvancedPanel" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkUnmapped" Style="{DynamicResource CheckBoxSoft}" Content="启用未映射用户访问" Margin="0,0,0,4" />
                    <CheckBox x:Name="ChkAllowRoot" Style="{DynamicResource CheckBoxSoft}" Content="允许 root 访问" Margin="0,0,0,4" />
                    <TextBlock Text="匿名 UID（0=默认）" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAnonUid" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    <TextBlock Text="匿名 GID（0=默认）" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtAnonGid" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- ===== FTP 专有 ===== -->
            <StackPanel x:Name="BlockFtp" Visibility="Collapsed">
                <TextBlock Text="端口" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtFtpPort" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Width="120" HorizontalAlignment="Left"
                         Text="21" Margin="0,0,0,8" />
                <TextBlock Text="SSL 策略" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadFtpSslAllow" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Ssl" Content="允许" IsChecked="True" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpSslRequire" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Ssl" Content="要求" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpSslCred" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Ssl" Content="要求凭据" />
                </StackPanel>
                <TextBlock Text="认证模式" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <StackPanel Margin="0,0,0,8">
                    <RadioButton x:Name="RadFtpAnon" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Auth" Content="匿名" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpBasic" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Auth" Content="基本" IsChecked="True" Margin="0,0,0,6" />
                    <RadioButton x:Name="RadFtpWin" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" GroupName="Auth" Content="Windows" />
                </StackPanel>
            </StackPanel>

            <!-- ===== WebDAV 专有 ===== -->
            <StackPanel x:Name="BlockWebdav" Visibility="Collapsed">
                <TextBlock Text="端口" FontSize="{DynamicResource FontSizeSecondary}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtWdavPort" Style="{DynamicResource InputBoxSoft}" FontSize="{DynamicResource FontSizeBody}" Width="120" HorizontalAlignment="Left"
                         Text="80" Margin="0,0,0,8" />
                <CheckBox x:Name="ChkWdavAnon" Content="启用匿名访问" Style="{DynamicResource CheckBoxSoft}" Margin="0,0,0,8" />
            </StackPanel>

            <TextBlock x:Name="LblError" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushDangerStrong}"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="取消" Style="{DynamicResource DashButton}" Click="OnCancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button Content="创建" Style="{DynamicResource PrimaryButton}" Click="OnCreate" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
