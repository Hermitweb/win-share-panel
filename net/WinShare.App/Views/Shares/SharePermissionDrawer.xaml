<UserControl x:Class="WinShare.App.Views.Shares.SharePermissionDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinShare.App.Views.Shares"
             Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
             BorderThickness="1,0,0,0">
    <UserControl.Resources>
        <local:AccessLabelConverter x:Key="AccessLabel" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DrawerTitle" Grid.Row="0" Text="权限管理" FontSize="16"
                   FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- TS Tabs：共享权限 / NTFS 权限；1 列纵向流：区块选择器纵向堆叠，正文区纵向全展开、选中区块可见 -->
        <StackPanel x:Name="Tabs" Grid.Row="1" Margin="0,0,0,12">
            <RadioButton x:Name="RbShare" GroupName="PermTab" Content="共享权限" IsChecked="True"
                         Checked="OnTabChanged" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" />
            <RadioButton x:Name="RbNtfs" GroupName="PermTab" Content="NTFS 权限"
                         Checked="OnTabChanged" Style="{DynamicResource SegmentRadio}" HorizontalAlignment="Left" />
        </StackPanel>

        <StackPanel x:Name="TabContent" Grid.Row="2">
            <!-- 共享权限（TS：行表格 + 添加账号 + 候选提示 + 保存确认） -->
            <StackPanel x:Name="SecShare" Margin="0,8,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="修改后点击「保存」生效。Deny 优先于其他权限。" FontSize="12"
                                   Foreground="{DynamicResource BrushFog}" />
                        <Button Content="重新加载" Style="{DynamicResource RowActionButton}" Click="OnReload"
                                HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                    <DataGrid x:Name="RowsGrid" Style="{DynamicResource SoftDataGrid}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              FontSize="12" RowHeaderWidth="0" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding account}" Width="180" />
                            <DataGridTextColumn Header="类型" Binding="{Binding accountType}" Width="90" />
                            <DataGridTextColumn Header="权限" Binding="{Binding access, Converter={StaticResource AccessLabel}}" Width="140" />
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="删除" Style="{DynamicResource RowActionButtonDanger}"
                                                Click="OnRemoveRow" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="{DynamicResource BrushBgMist}"
                             Padding="8" CornerRadius="{DynamicResource RadiusInput}"
                             BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                        <StackPanel>
                        <TextBlock Text="添加账号" FontSize="12" Foreground="{DynamicResource BrushFog}"
                                   Margin="0,0,0,6" />
                        <!-- 1 列纵向流：账号/类型/权限/添加各自独占一行（每行控件靠左，宽度收敛） -->
                        <StackPanel>
                            <TextBox x:Name="TxtNewAccount" Width="220" HorizontalAlignment="Left"
                                     Style="{DynamicResource InputBoxSoft}" Margin="0,0,0,6" />
                            <ComboBox x:Name="CmbNewType" Width="90" HorizontalAlignment="Left" FontSize="13"
                                      Style="{DynamicResource ComboBoxSoft}" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="用户" Tag="User" />
                                <ComboBoxItem Content="组" Tag="Group" />
                            </ComboBox>
                            <ComboBox x:Name="CmbNewAccess" Width="110" HorizontalAlignment="Left" FontSize="13"
                                      Style="{DynamicResource ComboBoxSoft}" SelectedIndex="2" Margin="0,0,0,6">
                                <ComboBoxItem Content="完全控制" Tag="Full" />
                                <ComboBoxItem Content="更改" Tag="Change" />
                                <ComboBoxItem Content="只读" Tag="Read" />
                                <ComboBoxItem Content="拒绝" Tag="Deny" />
                            </ComboBox>
                            <Button Content="添加" Style="{DynamicResource RowActionButton}" Click="OnAddRow"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock x:Name="CandTip" FontSize="11" Foreground="{DynamicResource BrushFog}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="RowMsg" FontSize="12" Foreground="{DynamicResource BrushDangerStrong}"
                                   Margin="0,4,0,0" Visibility="Collapsed" />
                        <!-- 按钮区（页脚操作行）：横向右对齐保持 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="保存" Style="{DynamicResource DashButton}" Click="OnSave" />
                            <TextBlock x:Name="SaveMsg" FontSize="12" VerticalAlignment="Center"
                                       Margin="8,0,0,0" Foreground="{DynamicResource BrushFog}" />
                        </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </StackPanel>

            <!-- NTFS 权限（TS：只读 ACL 视图 + v2.1 编辑授权：添加/移除/继承，icacls 通道） -->
            <StackPanel x:Name="SecNtfs" Margin="0,8,0,0">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="NtfsPathText" FontSize="12" Foreground="{DynamicResource BrushFog}"
                               TextWrapping="Wrap" />
                    <Button Content="加载" Style="{DynamicResource RowActionButton}" Click="OnLoadNtfs"
                            HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
                    <Grid>
                        <DataGrid x:Name="NtfsGrid" Style="{DynamicResource SoftDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  FontSize="12" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="账号" Binding="{Binding account}" Width="*" />
                                <DataGridTextColumn Header="权限" Binding="{Binding rights}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding type}" Width="80" />
                                <DataGridTextColumn Header="继承" Binding="{Binding inherited}" Width="70" />
                                <DataGridTemplateColumn Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="移除" Style="{DynamicResource RowActionButtonDanger}"
                                                    Padding="6,1" Margin="2,0" Click="OnNtfsRevoke"
                                                    ToolTip="移除该账号在此路径的全部授权（icacls /remove）" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="NtfsEmpty" Text="点击「加载」查看 NTFS ACL" FontSize="13"
                                   Foreground="{DynamicResource BrushFog}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                <!-- 编辑授权（v2.1 解锁：添加授权 + 继承控制，写入后自动重读 ACL） -->
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="账号：" FontSize="12" VerticalAlignment="Center" />
                        <ComboBox x:Name="NtfsAccountBox" Width="200" IsEditable="True" FontSize="12"
                                  Style="{DynamicResource ComboBoxSoft}"
                                  ToolTip="可从下拉选择本地用户/组，或直接输入（支持 DOMAIN\user）" />
                        <TextBlock Text="级别：" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ComboBox x:Name="NtfsRightsBox" Width="120" FontSize="12" SelectedIndex="1"
                                  Style="{DynamicResource ComboBoxSoft}">
                            <ComboBoxItem Content="读取" Tag="R" />
                            <ComboBoxItem Content="读取和执行" Tag="RX" />
                            <ComboBoxItem Content="写入" Tag="W" />
                            <ComboBoxItem Content="修改" Tag="M" />
                            <ComboBoxItem Content="完全控制" Tag="F" />
                        </ComboBox>
                        <CheckBox x:Name="NtfsOiBox" Content="应用到文件(OI)" IsChecked="True" FontSize="12"
                                  Style="{DynamicResource CheckBoxSoft}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <CheckBox x:Name="NtfsCiBox" Content="应用到子目录(CI)" IsChecked="True" FontSize="12"
                                  Style="{DynamicResource CheckBoxSoft}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <Button Content="添加授权" Style="{DynamicResource DashButton}" Margin="10,0,0,0" Click="OnNtfsGrant" />
                        <Button Content="启用继承" Style="{DynamicResource DashButton}" Margin="10,0,0,0"
                                Click="OnNtfsInheritOn" ToolTip="恢复从父目录继承（icacls /inheritance:e）" />
                        <Button Content="禁用继承" Style="{DynamicResource DashButton}" Margin="8,0,0,0"
                                Click="OnNtfsInheritOff" ToolTip="继承项复制为显式项，可安全编辑（icacls /inheritance:d）" />
                    </StackPanel>
                    <TextBlock x:Name="NtfsMsg" FontSize="12" Foreground="{DynamicResource BrushFog}"
                               Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
