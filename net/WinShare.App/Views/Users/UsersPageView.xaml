<UserControl x:Class="WinShare.App.Views.Users.UsersPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinShare.App.Views.Users">
    <!--
      用户与权限页（对齐 src/pages/Users.tsx）：
      本地用户 / 本地组 / 权限矩阵（Deny 优先 + CSV/JSON/HTML 导出）/ NTFS 权限查看。
      界面逻辑全部在 UsersViewModel；本视图只做装配 + 数据到控件映射（T3a 仪表板同模式）。
      文案为硬编码中文（对齐 TS 界面；i18n 键扩展需改共享 Strings 文件，留调度者决策，见模块回报）。
    -->
    <UserControl.Resources>
        <conv:MatrixCellConverter x:Key="MatrixCell" />
    </UserControl.Resources>
    <Grid Margin="20" Background="{DynamicResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 刷新（对齐 Users.tsx header Space） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="用户与权限" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnRefresh" Content="刷新" Style="{DynamicResource DashButton}"
                         Click="OnRefresh" />
                <TextBlock x:Name="StatusTip" FontSize="12" Foreground="{DynamicResource BrushFog}"
                           Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>

        <!-- Tab 选择（对齐 antd Tabs：本地用户 / 本地组 / 权限矩阵 / NTFS 权限） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="TabUsers" GroupName="UsersTab" Content="本地用户" IsChecked="True"
                         Checked="OnTab" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="TabGroups" GroupName="UsersTab" Content="本地组"
                         Checked="OnTab" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="TabMatrix" GroupName="UsersTab" Content="权限矩阵"
                         Checked="OnTab" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="TabNtfs" GroupName="UsersTab" Content="NTFS 权限"
                         Checked="OnTab" FontSize="13" />
        </StackPanel>

        <!-- 批量操作条（仅用户 Tab；对齐 TS 选中后出现的蓝色操作条） -->
        <Border x:Name="BatchBar" Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8"
                Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BatchCount" Text="已选 0 个用户" FontSize="12"
                           VerticalAlignment="Center" Margin="4,0,12,0" />
                <Button x:Name="BtnBatchEnable" Content="批量启用" Style="{DynamicResource DashButton}"
                         Click="OnBatchEnable" Padding="8,2" FontSize="12" />
                <Button x:Name="BtnBatchDisable" Content="批量禁用" Style="{DynamicResource DashButton}"
                         Click="OnBatchDisable" Padding="8,2" FontSize="12" Margin="8,0,0,0" />
                <Button x:Name="BtnBatchAssign" Content="分配到组" Style="{DynamicResource DashButton}"
                         Click="OnBatchAssign" Padding="8,2" FontSize="12" Margin="8,0,0,0" />
                <Button x:Name="BtnBatchDelete" Content="批量删除" Style="{DynamicResource DashButton}"
                         Click="OnBatchDelete" Padding="8,2" FontSize="12" Margin="8,0,0,0" />
                <Button x:Name="BtnBatchClear" Content="取消选择" Style="{DynamicResource DashButton}"
                         Click="OnBatchClear" Padding="8,2" FontSize="12" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 提示/错误条（首轮失败、服务缺席等） -->
        <TextBlock x:Name="NoticeBar" Grid.Row="3" FontSize="12" Foreground="{DynamicResource BrushDanger}"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Grid.Row="4">
            <!-- ===== 本地用户面板 ===== -->
            <Border x:Name="UsersPanel" Style="{DynamicResource CardStyle}">
                <DockPanel>
                    <!-- 工具行：搜索 + 字段 + 仅启用 + 新建（对齐 TS 工具行） -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="SearchBox" Width="240" Padding="6,3" FontSize="13"
                                 ToolTip="搜索用户名" TextChanged="OnFilterChanged" />
                        <ComboBox x:Name="SearchFieldCombo" Width="110" Margin="8,0,0,0" FontSize="12"
                                  SelectionChanged="OnSearchFieldChanged">
                            <ComboBoxItem Content="仅用户名" IsSelected="True" />
                            <ComboBoxItem Content="全部字段" />
                        </ComboBox>
                        <CheckBox x:Name="OnlyEnabledChk" Content="仅启用" FontSize="12"
                                  Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnFilterChanged"
                                  Unchecked="OnFilterChanged" />
                        <Button x:Name="BtnCreateUser" Content="+ 新建用户" HorizontalAlignment="Right"
                                Style="{DynamicResource DashButton}" Margin="16,0,0,0"
                                VerticalAlignment="Center" Click="OnCreateUser" />
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionUnit="FullRow" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="13"
                              SelectionChanged="OnUsersSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="用户名" Binding="{Binding user.name}" Width="140" />
                            <DataGridTextColumn Header="全名" Binding="{Binding user.fullName}" Width="140" />
                            <DataGridTemplateColumn Header="状态" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="描述" Binding="{Binding user.description}" Width="*" />
                            <DataGridTemplateColumn Header="所属组" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupsText}" FontSize="12" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="上次登录" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastLogonText}" FontSize="12"
                                                   Foreground="{DynamicResource BrushFog}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑" FontSize="12" Padding="6,1"
                                                    ToolTip="编辑属性" Click="OnEditUser" Tag="{Binding}" />
                                            <Button Content="切换" FontSize="12" Padding="6,1"
                                                    Margin="6,0,0,0" ToolTip="启用/禁用账号"
                                                    Click="OnToggleUser" Tag="{Binding}" />
                                            <Button Content="删除" FontSize="12" Padding="6,1"
                                                    Margin="6,0,0,0" Foreground="#FF4D4F"
                                                    Click="OnDeleteUser" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===== 本地组面板 ===== -->
            <Border x:Name="GroupsPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="系统内置组（如 Administrators/Users）不可删除，但可管理成员。"
                                   FontSize="12" Foreground="{DynamicResource BrushFog}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnCreateGroup" Content="+ 新建组" HorizontalAlignment="Right"
                                Style="{DynamicResource DashButton}" Click="OnCreateGroup" />
                    </StackPanel>
                    <DataGrid x:Name="GroupsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionUnit="FullRow" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="组名" Binding="{Binding group.name}" Width="160" />
                            <DataGridTextColumn Header="描述" Binding="{Binding group.description}" Width="*" />
                            <DataGridTextColumn Header="成员数" Binding="{Binding MemberCount}" Width="70" />
                            <DataGridTextColumn Header="成员预览" Binding="{Binding MembersPreview}" Width="320" />
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="管理成员" FontSize="12" Padding="6,1"
                                                    Click="OnManageGroup" Tag="{Binding}" />
                                            <Button Content="删除" FontSize="12" Padding="6,1" Margin="6,0,0,0"
                                                    Foreground="#FF4D4F" Click="OnDeleteGroup" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===== 权限矩阵面板 ===== -->
            <Border x:Name="MatrixPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="MatrixHint" Text="" FontSize="12"
                                   Foreground="{DynamicResource BrushFog}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="420" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnMatrixReload" Content="重新加载" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="12" Click="OnMatrixReload" />
                            <Button x:Name="BtnMatrixCancel" Content="取消" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="12" Margin="8,0,0,0" Click="OnMatrixCancel"
                                    Visibility="Collapsed" />
                            <Button x:Name="BtnExportCsv" Content="导出 CSV" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="12" Margin="8,0,0,0" Click="OnExportCsv" />
                            <Button x:Name="BtnExportJson" Content="导出 JSON" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="12" Margin="8,0,0,0" Click="OnExportJson" />
                            <Button x:Name="BtnExportHtml" Content="导出报告(HTML)" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="12" Margin="8,0,0,0" Click="OnExportHtml" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="MatrixGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="All" FontSize="12"
                              HorizontalScrollBarVisibility="Auto"
                              Height="480" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <!-- ===== NTFS 权限面板 ===== -->
            <Border x:Name="NtfsPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="查看路径 NTFS 权限：" FontSize="12" VerticalAlignment="Center" />
                        <TextBox x:Name="NtfsPathBox" Width="360" Padding="6,3" FontSize="13"
                                 Margin="8,0,0,0" ToolTip="如 C:\Users 或某共享路径" />
                        <Button x:Name="BtnNtfsView" Content="查看" Style="{DynamicResource DashButton}"
                                Margin="8,0,0,0" Click="OnNtfsView" />
                    </StackPanel>
                    <DataGrid x:Name="NtfsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding entry.account}" Width="260" />
                            <DataGridTextColumn Header="权限" Binding="{Binding entry.rights}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="60" />
                            <DataGridTextColumn Header="继承" Binding="{Binding entry.inherited}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
