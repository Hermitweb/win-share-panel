<UserControl x:Class="WinShare.App.Views.Users.UsersPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinShare.App.Views.Users">
    <!--
      用户与权限页（对齐 src/pages/Users.tsx）：
      本地用户 / 本地组 / 权限矩阵（Deny 优先 + CSV/JSON/HTML 导出）/ NTFS 权限查看。
      界面逻辑全部在 UsersViewModel；本视图只做装配 + 数据到控件映射（T3a 仪表板同模式）。
      文案为硬编码中文（对齐 TS 界面；i18n 键扩展需改共享 Strings 文件，留调度者决策，见模块回报）。
    -->
    <UserControl.Resources>
        <conv:MatrixCellConverter x:Key="MatrixCell" />
    </UserControl.Resources>
    <Grid Margin="20" Background="{DynamicResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 刷新（对齐 Electron PageHeader：标题与侧栏导航名一致；统一 PageTitle + Nav.* 键） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Nav.Users}"
                       Style="{DynamicResource PageTitle}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="StatusTip" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushFog}"
                           Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </DockPanel>

        <!-- Tab 选择（对齐 Electron antd Tabs：横向；外观走 App.xaml 的 TabRadio） -->
        <Border Grid.Row="1" Margin="0,0,0,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BrushBorder}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabUsers" GroupName="UsersTab" Content="本地用户" IsChecked="True"
                             Checked="OnTab" Style="{DynamicResource TabRadio}" />
                <RadioButton x:Name="TabGroups" GroupName="UsersTab" Content="本地组"
                             Checked="OnTab" Style="{DynamicResource TabRadio}" />
                <RadioButton x:Name="TabMatrix" GroupName="UsersTab" Content="权限矩阵"
                             Checked="OnTab" Style="{DynamicResource TabRadio}" />
                <RadioButton x:Name="TabNtfs" GroupName="UsersTab" Content="NTFS 权限"
                             Checked="OnTab" Style="{DynamicResource TabRadio}" />
            </StackPanel>
        </Border>

        <!-- 批量操作条（仅用户 Tab；对齐 Electron 横向：计数在左、按钮在右） -->
        <Border x:Name="BatchBar" Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8"
                Margin="0,0,0,8" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnBatchEnable" Content="批量启用" Style="{DynamicResource RowActionButton}"
                            Click="OnBatchEnable" />
                    <Button x:Name="BtnBatchDisable" Content="批量禁用" Style="{DynamicResource RowActionButton}"
                            Click="OnBatchDisable" Margin="4,0,0,0" />
                    <Button x:Name="BtnBatchAssign" Content="分配到组" Style="{DynamicResource RowActionButton}"
                            Click="OnBatchAssign" Margin="4,0,0,0" />
                    <Button x:Name="BtnBatchDelete" Content="批量删除" Style="{DynamicResource RowActionButtonDanger}"
                            Click="OnBatchDelete" Margin="4,0,0,0" />
                    <Button x:Name="BtnBatchClear" Content="取消选择" Style="{DynamicResource RowActionButton}"
                            Click="OnBatchClear" Margin="4,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="BatchCount" Text="已选 0 个用户" FontSize="{DynamicResource FontSizeSecondary}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 提示/错误条（首轮失败、服务缺席等） -->
        <TextBlock x:Name="NoticeBar" Grid.Row="3" FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushDanger}"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Grid.Row="4">
            <!-- ===== 本地用户面板 ===== -->
            <Border x:Name="UsersPanel" Style="{DynamicResource CardStyle}">
                <DockPanel>
                    <!-- 工具行：搜索 + 字段 + 仅启用 + 新建（对齐 Electron 横向工具行） -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                VerticalAlignment="Center">
                        <Grid>
                            <!-- 占位提示后声明（画在输入框之上）：此前被不透明输入框背景遮住 -->
                            <TextBox x:Name="SearchBox" Width="240" Style="{DynamicResource InputBoxSoft}"
                                     ToolTip="搜索用户名" TextChanged="OnFilterChanged" />
                            <TextBlock x:Name="SearchHint" Text="搜索用户名…" FontSize="{DynamicResource FontSizeBody}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushFog}" IsHitTestVisible="False" />
                        </Grid>
                        <ComboBox x:Name="SearchFieldCombo" Width="110" Style="{DynamicResource ComboBoxSoft}"
                                  SelectionChanged="OnSearchFieldChanged" Margin="8,0,0,0"
                                  ToolTip="搜索范围：仅用户名 或 全部字段">
                            <ComboBoxItem Content="仅用户名" IsSelected="True" />
                            <ComboBoxItem Content="全部字段" />
                        </ComboBox>
                        <CheckBox x:Name="OnlyEnabledChk" Content="仅启用" Style="{DynamicResource CheckBoxSoft}"
                                  Margin="14,0,0,0" VerticalAlignment="Center"
                                  Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource BrushBorder}"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                        <Button x:Name="BtnCreateUser" Content="+ 新建用户"
                                Style="{DynamicResource PrimaryButton}"
                                Margin="12,0,0,0" Click="OnCreateUser" />
                    </StackPanel>
                    <DataGrid x:Name="UsersGrid" Style="{DynamicResource SoftDataGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionUnit="FullRow" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSizeBody}"
                              SelectionChanged="OnUsersSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="用户名" Binding="{Binding user.name}" Width="150" MinWidth="120" />
                            <DataGridTextColumn Header="全名" Binding="{Binding user.fullName}" Width="150" MinWidth="100" />
                            <DataGridTemplateColumn Header="状态" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSizeSecondary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="描述" Binding="{Binding user.description}" Width="*" MinWidth="120" MaxWidth="320" />
                            <DataGridTemplateColumn Header="所属组" Width="*" MinWidth="160" MaxWidth="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GroupsText}" FontSize="{DynamicResource FontSizeSecondary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="上次登录" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastLogonText}" FontSize="{DynamicResource FontSizeSecondary}"
                                                   Foreground="{DynamicResource BrushFog}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="Auto" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="编辑" Style="{DynamicResource RowActionButton}"
                                                    ToolTip="编辑属性" Click="OnEditUser" Tag="{Binding}" />
                                            <Button Content="切换" Style="{DynamicResource RowActionButton}"
                                                    Margin="4,0,0,0" ToolTip="启用/禁用账号"
                                                    Click="OnToggleUser" Tag="{Binding}" />
                                            <Button Content="删除" Style="{DynamicResource RowActionButtonDanger}"
                                                    Margin="4,0,0,0"
                                                    Click="OnDeleteUser" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
<!-- v2.2.0 第五批：空态 = 一句状态 + 一个主按钮；加载态给骨架行 -->
                    <StackPanel x:Name="UsersEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="暂无本地用户" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource BrushText}" />
                        <TextBlock Text="点击右侧「新建用户」创建第一个本地账号" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushFog}" HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="UsersLoading" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <!-- 加载态：居中转圈（替代原顶部横条） -->
                        <Grid Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Ellipse Width="46" Height="46" Stroke="{DynamicResource BrushBorder}" StrokeThickness="3" />
                            <Path Stroke="{DynamicResource BrushPrimary}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 23,4 A 19,19 0 0 1 42,23">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="UsersSpinRotate" CenterX="23" CenterY="23" />
                                </Path.RenderTransform>
                            </Path>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Grid.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="UsersSpinRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock Text="正在读取本地用户…" FontSize="{DynamicResource FontSizeBody}"
                                   Foreground="{DynamicResource BrushFog}" Margin="0,0,0,12" HorizontalAlignment="Center" />
                        <StackPanel x:Name="UsersSkeletonRows" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== 本地组面板 ===== -->
            <Border x:Name="GroupsPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DockPanel>
                    <!-- 工具行：提示在左、新建组按钮在右（对齐 Electron 横向工具行） -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <Button x:Name="BtnCreateGroup" Content="+ 新建组" DockPanel.Dock="Right"
                                Style="{DynamicResource DashButton}" Click="OnCreateGroup" />
                        <TextBlock Text="系统内置组（如 Administrators/Users）不可删除，但可管理成员。"
                                   FontSize="{DynamicResource FontSizeSecondary}" Foreground="{DynamicResource BrushFog}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="460" />
                    </DockPanel>
                    <DataGrid x:Name="GroupsGrid" Style="{DynamicResource SoftDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionUnit="FullRow" CanUserAddRows="False"
                              GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSizeBody}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="组名" Binding="{Binding group.name}" Width="160" />
                            <DataGridTextColumn Header="描述" Binding="{Binding group.description}" Width="*" />
                            <DataGridTextColumn Header="成员数" Binding="{Binding MemberCount}" Width="70" />
                            <DataGridTextColumn Header="成员预览" Binding="{Binding MembersPreview}" Width="320" />
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="管理成员" Style="{DynamicResource RowActionButton}"
                                                    Click="OnManageGroup" Tag="{Binding}" />
                                            <Button Content="删除" Style="{DynamicResource RowActionButtonDanger}"
                                                    Margin="4,0,0,0" Click="OnDeleteGroup" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ===== 权限矩阵面板 ===== -->
            <Border x:Name="MatrixPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <Grid>
                <DockPanel>
                    <!-- 横向：提示在左、操作按钮在右（对齐 Electron 工具行） -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BtnMatrixReload" Content="重新加载" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="{DynamicResource FontSizeSecondary}" Click="OnMatrixReload" />
                            <Button x:Name="BtnMatrixCancel" Content="取消" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="{DynamicResource FontSizeSecondary}" Margin="8,0,0,0" Click="OnMatrixCancel"
                                    Visibility="Collapsed" />
                            <Button x:Name="BtnExportCsv" Content="导出 CSV" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="{DynamicResource FontSizeSecondary}" Margin="8,0,0,0" Click="OnExportCsv" />
                            <Button x:Name="BtnExportJson" Content="导出 JSON" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="{DynamicResource FontSizeSecondary}" Margin="8,0,0,0" Click="OnExportJson" />
                            <Button x:Name="BtnExportHtml" Content="导出报告(HTML)" Style="{DynamicResource DashButton}"
                                    Padding="8,2" FontSize="{DynamicResource FontSizeSecondary}" Margin="8,0,0,0" Click="OnExportHtml" />
                        </StackPanel>
                        <TextBlock x:Name="MatrixHint" Text="" FontSize="{DynamicResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushFog}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420" />
                    </DockPanel>
                    <DataGrid x:Name="MatrixGrid" Style="{DynamicResource SoftDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSizeSecondary}"
                              HorizontalScrollBarVisibility="Auto"
                              Height="480" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
                <!-- 矩阵加载态：列表区居中转圈（MatrixLoading 时显示） -->
                <StackPanel x:Name="MatrixSpin" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Ellipse Width="46" Height="46" Stroke="{DynamicResource BrushBorder}" StrokeThickness="3" />
                        <Path Stroke="{DynamicResource BrushPrimary}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 23,4 A 19,19 0 0 1 42,23">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="MatrixSpinRotate" CenterX="23" CenterY="23" />
                            </Path.RenderTransform>
                        </Path>
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="MatrixSpinRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                    <TextBlock Text="正在加载权限矩阵…" FontSize="{DynamicResource FontSizeBody}"
                               Foreground="{DynamicResource BrushFog}" HorizontalAlignment="Center" />
                </StackPanel>
                </Grid>
            </Border>

            <!-- ===== NTFS 权限面板 ===== -->
            <Border x:Name="NtfsPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DockPanel>
                    <!-- 横向：标签 + 路径框 + 查看按钮（对齐 Electron 工具行） -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                VerticalAlignment="Center">
                        <TextBlock Text="查看路径 NTFS 权限：" FontSize="{DynamicResource FontSizeSecondary}" VerticalAlignment="Center" />
                        <!-- v2.2.0 第二轮：路径改可下拉（候选=本机普通共享），保留手输任意路径 -->
                        <ComboBox x:Name="NtfsPathBox" Width="360" IsEditable="True" FontSize="{DynamicResource FontSizeSecondary}"
                                  Style="{DynamicResource ComboBoxSoft}"
                                  Margin="8,0,0,0"
                                  ToolTip="下拉选择本机共享路径，或直接输入任意路径（如 C:\Users）" />
                        <Button x:Name="BtnNtfsView" Content="查看" Style="{DynamicResource DashButton}"
                                Margin="8,0,0,0" Click="OnNtfsView" />
                    </StackPanel>
                    <!-- 编辑授权（v2.1 解锁：添加/移除授权 + 继承控制，icacls 通道） -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="编辑授权：选择账号与级别后「添加授权」；行内「移除」删除该账号全部授权；" FontSize="{DynamicResource FontSizeSecondary}"
                                   Foreground="{DynamicResource BrushFog}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="账号：" FontSize="{DynamicResource FontSizeSecondary}" VerticalAlignment="Center" />
                            <ComboBox x:Name="NtfsAccountBox" Width="200" IsEditable="True" FontSize="{DynamicResource FontSizeSecondary}"
                                      Style="{DynamicResource ComboBoxSoft}"
                                      ToolTip="可从下拉选择本地用户/组，或直接输入（支持 DOMAIN\user）" />
                            <TextBlock Text="级别：" FontSize="{DynamicResource FontSizeSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <ComboBox x:Name="NtfsRightsBox" Width="120" FontSize="{DynamicResource FontSizeSecondary}" SelectedIndex="1"
                                      Style="{DynamicResource ComboBoxSoft}">
                                <ComboBoxItem Content="读取" Tag="R" />
                                <ComboBoxItem Content="读取和执行" Tag="RX" />
                                <ComboBoxItem Content="写入" Tag="W" />
                                <ComboBoxItem Content="修改" Tag="M" />
                                <ComboBoxItem Content="完全控制" Tag="F" />
                            </ComboBox>
                            <CheckBox x:Name="NtfsOiBox" Content="应用到文件(OI)" IsChecked="True" FontSize="{DynamicResource FontSizeSecondary}"
                                      Style="{DynamicResource CheckBoxSoft}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="NtfsCiBox" Content="应用到子目录(CI)" IsChecked="True" FontSize="{DynamicResource FontSizeSecondary}"
                                      Style="{DynamicResource CheckBoxSoft}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Button Content="添加授权" Style="{DynamicResource DashButton}" Margin="10,0,0,0" Click="OnNtfsGrant" />
                            <Button Content="启用继承" Style="{DynamicResource DashButton}" Margin="10,0,0,0"
                                    Click="OnNtfsInheritOn" ToolTip="恢复从父目录继承（icacls /inheritance:e）" />
                            <Button Content="禁用继承" Style="{DynamicResource DashButton}" Margin="8,0,0,0"
                                    Click="OnNtfsInheritOff" ToolTip="继承项复制为显式项，可安全编辑（icacls /inheritance:d）" />
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="NtfsGrid" Style="{DynamicResource SoftDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="{DynamicResource FontSizeBody}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding entry.account}" Width="260" />
                            <DataGridTextColumn Header="权限" Binding="{Binding entry.rights}" Width="*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="60" />
                            <DataGridTextColumn Header="继承" Binding="{Binding entry.inherited}" Width="60" />
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="移除" Style="{DynamicResource RowActionButtonDanger}"
                                                Padding="6,1" Margin="2,0" Click="OnNtfsRevoke"
                                                ToolTip="移除该账号在此路径的全部授权（icacls /remove）" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
