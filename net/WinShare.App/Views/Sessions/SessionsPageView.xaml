<UserControl x:Class="WinShare.App.Views.Sessions.SessionsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      会话监控页（对齐 src/pages/Sessions.tsx）：
      协议 Tab（SMB/NFS/FTP/WebDAV）、可配置刷新间隔（1|5|10|30s）+ 暂停/恢复 + 倒计时、
      会话/打开文件表、单条与批量强断（确认框对齐 Popconfirm/modal.confirm）。
      界面逻辑全部在 SessionsViewModel；本视图只做装配 + 映射。
    -->
    <Grid Margin="20" Background="{DynamicResource BrushBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 刷新间隔/暂停/倒计时/刷新（对齐 TS header Space） -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="会话监控" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="刷新间隔" FontSize="12" Foreground="{DynamicResource BrushFog}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="IntervalCombo" Width="80" FontSize="13"
                          SelectionChanged="OnIntervalChanged">
                    <ComboBoxItem Content="1s" Tag="1" />
                    <ComboBoxItem Content="5s" Tag="5" IsSelected="True" />
                    <ComboBoxItem Content="10s" Tag="10" />
                    <ComboBoxItem Content="30s" Tag="30" />
                </ComboBox>
                <Button x:Name="BtnPause" Content="暂停" Style="{DynamicResource DashButton}"
                        Margin="8,0,0,0" Click="OnPauseToggle" />
                <Border x:Name="CountdownTag" CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                        Background="#E6F4FF" VerticalAlignment="Center">
                    <TextBlock x:Name="CountdownText" Text="5s" FontSize="12" Foreground="#1677FF" />
                </Border>
                <Button x:Name="BtnRefresh" Content="刷新" Style="{DynamicResource DashButton}"
                        Margin="8,0,0,0" Click="OnRefresh" />
            </StackPanel>
        </DockPanel>

        <!-- 协议 Tab（对齐 protoTabs：SMB/NFS 有会话；FTP/WebDAV 无原生会话 API → 空态引导） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="ProtoSmb" GroupName="Proto" Content="SMB" IsChecked="True"
                         Checked="OnProto" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="ProtoNfs" GroupName="Proto" Content="NFS"
                         Checked="OnProto" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="ProtoFtp" GroupName="Proto" Content="FTP"
                         Checked="OnProto" FontSize="13" Margin="0,0,16,0" />
            <RadioButton x:Name="ProtoWebdav" GroupName="Proto" Content="WebDAV"
                         Checked="OnProto" FontSize="13" />
        </StackPanel>

        <!-- 选中操作条（对齐 selectionBar：已选 N / 清空 / 批量断开） -->
        <Border x:Name="SelectionBar" Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="8"
                Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SelectedCount" Text="已选 0" FontSize="12"
                           Foreground="{DynamicResource BrushFog}" VerticalAlignment="Center"
                           Margin="4,0,12,0" />
                <Button x:Name="BtnClearSelection" Content="清空" Style="{DynamicResource DashButton}"
                         Padding="8,2" FontSize="12" Click="OnClearSelection" />
                <Button x:Name="BtnBatchClose" Content="批量断开" Style="{DynamicResource DashButton}"
                         Padding="8,2" FontSize="12" Margin="8,0,0,0" Foreground="#FF4D4F"
                         Click="OnBatchClose" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="NoticeBar" Grid.Row="3" FontSize="12" Foreground="{DynamicResource BrushDanger}"
                   Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap"
                   HorizontalAlignment="Left" />

        <Grid Grid.Row="4">
            <!-- ===== SMB：会话 + 打开文件 子 Tab ===== -->
            <Border x:Name="SmbPanel" Style="{DynamicResource CardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="SmbSessionsTab" GroupName="SmbSub" Content="会话 (0)"
                                     IsChecked="True" Checked="OnSmbSub" FontSize="13" Margin="0,0,16,0" />
                        <RadioButton x:Name="SmbFilesTab" GroupName="SmbSub" Content="打开文件 (0)"
                                     Checked="OnSmbSub" FontSize="13" />
                    </StackPanel>
                    <Grid>
                        <DataGrid x:Name="SessionGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionUnit="FullRow" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" FontSize="13"
                                  SelectionChanged="OnSessionSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="用户/客户端" Binding="{Binding session.clientUserName}" Width="160" />
                                <DataGridTextColumn Header="计算机" Binding="{Binding session.clientComputerName}" Width="160" />
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartText}" Width="160" />
                                <DataGridTextColumn Header="打开文件" Binding="{Binding session.clientOpenFiles}" Width="90" />
                                <DataGridTextColumn Header="空闲(秒)" Binding="{Binding session.clientIdleTime}" Width="90" />
                                <DataGridTemplateColumn Header="操作" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="断开" FontSize="12" Padding="6,1"
                                                    Foreground="#FF4D4F" Click="OnCloseSession" Tag="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal" FontSize="13"
                                  Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="路径" Binding="{Binding path}" Width="*" />
                                <DataGridTextColumn Header="用户" Binding="{Binding clientUserName}" Width="140" />
                                <DataGridTextColumn Header="计算机" Binding="{Binding clientComputerName}" Width="140" />
                                <DataGridTextColumn Header="锁" Binding="{Binding lockCount}" Width="60" />
                                <DataGridTemplateColumn Header="操作" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="关闭" FontSize="12" Padding="6,1"
                                                    Foreground="#FF4D4F" Click="OnCloseFile" Tag="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===== NFS：会话表（同 sessionColumns；无文件表） ===== -->
            <Border x:Name="NfsPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <DataGrid x:Name="NfsSessionGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionUnit="FullRow" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" FontSize="13"
                          SelectionChanged="OnSessionSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户/客户端" Binding="{Binding session.clientUserName}" Width="160" />
                        <DataGridTextColumn Header="计算机" Binding="{Binding session.clientComputerName}" Width="160" />
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartText}" Width="160" />
                        <DataGridTextColumn Header="打开文件" Binding="{Binding session.clientOpenFiles}" Width="90" />
                        <DataGridTextColumn Header="空闲(秒)" Binding="{Binding session.clientIdleTime}" Width="90" />
                        <DataGridTemplateColumn Header="操作" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="断开" FontSize="12" Padding="6,1"
                                            Foreground="#FF4D4F" Click="OnCloseSession" Tag="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ===== FTP/WebDAV：无原生会话 API 空态（对齐 TS Empty description） ===== -->
            <Border x:Name="EmptyPanel" Style="{DynamicResource CardStyle}" Visibility="Collapsed">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="{DynamicResource BrushFog}" TextWrapping="Wrap"
                           MaxWidth="520" TextAlignment="Center"
                           Text="FTP/WebDAV 无原生会话 API。可通过 IIS 日志（%SystemDrive%\inetpub\logs\LogFiles）查看连接记录。" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
