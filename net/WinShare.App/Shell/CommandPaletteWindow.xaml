<Window x:Class="WinShare.App.Shell.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="命令面板" Width="560" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="Manual" ResizeMode="NoResize">
    <!-- 命令面板：分组标题 + 行图标 + 行尾上下文；不再逐行常驻解释性副标题
         （反说明书原则：语义靠分组与图标传达，数据上下文靠行尾灰字）。
         v2.3：全屏透明遮罩 + 点击空白关闭；面板右上角关闭按钮；Esc 保留。 -->
    <Grid>
        <!-- 点击空白关闭层（透明但可命中；面板点击经 Panel 阻止冒泡） -->
        <Border x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="OnOverlayClick" />

        <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusBtn}"
                MouseLeftButtonDown="OnPanelClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <!-- 占位提示必须后声明（画在输入框之上） -->
                    <TextBox x:Name="TxtQuery" FontSize="{DynamicResource FontSizeSubtitle}" Padding="12,10,44,12"
                             BorderThickness="0,0,0,1" Background="Transparent"
                             Foreground="{DynamicResource BrushText}" CaretBrush="{DynamicResource BrushPrimary}"
                             TextChanged="OnQueryChanged" PreviewKeyDown="OnInputKeyDown" />
                    <TextBlock x:Name="QueryHint" Text="搜索共享、用户、会话，或输入命令…" FontSize="{DynamicResource FontSizeSubtitle}"
                               Margin="14,10,0,10" VerticalAlignment="Center"
                               Foreground="{DynamicResource BrushFog}" IsHitTestVisible="False" />
                    <!-- v2.3：关闭按钮（右上角；CaptionButtonDanger 的 hover 红反馈） -->
                    <Button x:Name="BtnClose" Content="✕" Style="{DynamicResource CaptionButtonDanger}"
                            Width="30" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                            Click="OnCloseClick" ToolTip="关闭（Esc）" TabIndex="1" />
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="384" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 分组标题（页内小标题，不加常驻解释句） -->
                                    <TextBlock Grid.Row="0" Text="{Binding Label}" Margin="14,10,14,4"
                                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushFog}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border x:Name="Row" Grid.Row="1" Background="Transparent" Padding="12,7"
                                            Cursor="Hand" MouseLeftButtonUp="OnRowClick"
                                            MouseEnter="OnRowMouseEnter" MouseLeave="OnRowMouseLeave"
                                            Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       Margin="0,0,10,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource BrushPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{DynamicResource FontSizeBody}"
                                                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Context}" FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource BrushFog}" Margin="14,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="220" ToolTip="{Binding Context}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Background="{DynamicResource BrushBg}" Padding="12,7"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="CountText" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource BrushFog}" VerticalAlignment="Center" />
                        <StackPanel x:Name="KeyHints" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="↑↓ 选择" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushFog}" Margin="0,0,12,0" />
                            <TextBlock Text="Enter 执行" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushFog}" Margin="0,0,12,0" />
                            <TextBlock Text="Esc / 点击空白 关闭" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushFog}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
