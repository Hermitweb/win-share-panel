<Application x:Class="WinShare.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <!--
      无 StartupUri：窗口由 App.OnStartup 手动创建（单实例锁/托盘/Win11 检测先行）。
      ShutdownMode=OnExplicitShutdown：关闭主窗口 = 托盘常驻（对齐 main.ts window-all-closed 拦截）。
      通用组件样式对齐 docs/UI_DESIGN.md §5：卡片 16px 圆角 + 磨砂玻璃 + 柔光弥散阴影，
      按钮 12px 圆角（主按钮=饱和蓝渐变、次按钮=磨砂白底浅蓝描边、危险=蜜桃粉渐变），
      标签 8px 圆角胶囊。色值全部走主题 token（DynamicResource 热切换）。
      v2.3 视觉重制：饱和科技蓝玻璃拟态（参考"全平台总控"风格稿）——token 值已重调，
      新增 hue 四色徽章/导航胶囊/Hero 渐变等 key（见 ThemeTokens.*..xaml）。
    -->
    <Application.Resources>
        <!-- v2.2.0 第二轮：字号标尺（五级）——新代码用令牌，存量字面量渐进收敛 -->
        <sys:Double x:Key="FontSizeCaption">11</sys:Double>
        <sys:Double x:Key="FontSizeSecondary">12</sys:Double>
        <sys:Double x:Key="FontSizeBody">13</sys:Double>
        <sys:Double x:Key="FontSizeSubtitle">14</sys:Double>
        <sys:Double x:Key="FontSizeTitle">16</sys:Double>
        <!-- v2.3：布尔→可见性（页头探测进度条等绑定用） -->
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <!-- v2.3：探测进度条（不确定进度扫动条） -->
        <Style x:Key="ProbeBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Width" Value="160" />
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{DynamicResource BrushBgMist}">
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                    Width="24" Background="{TemplateBinding Foreground}">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Width"
                                                                 From="16" To="144" Duration="0:0:1.1" AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== 卡片（规范 5.1） ===== -->
        <!-- v2.3 四轮：Hero 插画画刷（球体+轨道+光点，相对坐标 0-1）——
             DrawingBrush 作为 Hero 卡 Background，绕过 Grid 嵌套子元素不渲染的问题 -->
        <DrawingBrush x:Key="BrushHeroIllustration" Viewport="0,0,1,1" TileMode="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource BrushHeroGradient}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- 轨道环 1（蓝） -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#59 6FA3F0" Thickness="0.008" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.72,0.52" RadiusX="0.17" RadiusY="0.10" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- 轨道环 2（紫） -->
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#44 A78BFA" Thickness="0.008" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.72,0.52" RadiusX="0.15" RadiusY="0.09" Transform="Rotate(14,0.72,0.52)" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- 球体（多层圆模拟径向渐变，中心 0.72,0.5 半径 0.14） -->
                    <GeometryDrawing Brush="#1E4FB8">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.72,0.5" RadiusX="0.14" RadiusY="0.14" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#3B7BE8">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.72,0.5" RadiusX="0.115" RadiusY="0.115" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8FC1FF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.695,0.47" RadiusX="0.075" RadiusY="0.075" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#E6FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.685,0.455" RadiusX="0.038" RadiusY="0.038" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- 光点 -->
                    <GeometryDrawing Brush="#F08C1A">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.86,0.5" RadiusX="0.012" RadiusY="0.012" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8B5CF6">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="0.575,0.475" RadiusX="0.010" RadiusY="0.010" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="CardStyle" TargetType="Border">
            <!-- v2.3 四轮：玻璃渐变卡面（顶亮底透）+ 玻璃边缘渐变边框（顶高光底暗），伪造玻璃纵深 -->
            <Setter Property="Background" Value="{DynamicResource BrushCardGradient}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
            <Setter Property="Padding" Value="18,16" />
            <!-- Effect(ShadowCard) 已移除：DropShadowEffect 使内容走离屏渲染，
                 实测会破坏 ScrollViewer 的滚动状态（偏移写入被吞），且设置页
                 早已记录同类问题（整页未测量）。视觉层次由边框+底色承担。 -->
        </Style>

        <!-- ===== 横向 Tab（对齐 Electron antd Tabs；规范 §9 布局照搬） ===== -->
        <!--
          原先各页把 RadioButton 竖排当 Tab 用（1 列纵向流），与 Electron 版的横向 Tabs 不一致。
          这里给 RadioButton 套一层 Tab 外观：横向排列在 Tab 条里，选中态用底部高亮条 + 加粗，
          未选中态透明底。代码后置仍读 IsChecked，逻辑零改动。
        -->
        <Style x:Key="TabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="16,8" CornerRadius="8,8,0,0"
                                Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushGlassStrong}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 胶囊分段单选（仪表盘趋势三态 / 抽屉区块选择；对齐 antd Segmented） ===== -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="{DynamicResource RadiusTag}" Padding="12,4"
                                Background="{DynamicResource BrushBgMist}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInfoBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushInfoFg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 玻璃页签（TabControl/TabItem：对齐 Electron antd Tabs 的视觉） ===== -->
        <Style x:Key="GlassTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          极简勾选框：只用一个 Border 变色表示选中（无 Path、无 Stretch、无嵌套）。
          原 GlassCheckBox 用了 Path + Stretch="Uniform"，实测会让 4 个页面的布局崩掉
          （控件 BoundingRectangle 变空、内容不可见）。模板越简单越安全。
        -->
        <Style x:Key="CheckBoxSoft" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="32" /> <!-- v2.2.0 第四轮：触摸热区 -->
            <Setter Property="Margin" Value="0,3,16,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                    Background="{DynamicResource BrushBgMist}"
                                    BorderBrush="{DynamicResource BrushCheckBoxBorder}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉项（配 ComboBoxSoft 弹层：hover/选中走 token，替代系统蓝） -->
        <Style x:Key="ComboBoxItemSoft" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushInfoBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushInfoFg}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          极简下拉框：Border + ContentPresenter + 固定尺寸箭头 Path（无 Stretch）+ 标准 Popup。
          原 GlassComboBox 只设配色，被 WPF 默认模板盖掉（截图里仍是系统灰框）；
          自定义模板又必须保持结构极简 —— Path 用 Stretch 会让整页布局崩（见 CheckBoxSoft 注释）。
        -->
        <Style x:Key="ComboBoxSoft" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="30" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemSoft}" />
            <!-- 弹层必须虚拟化：默认 ItemsPanel 是 StackPanel，会把所有选项一次实例化
                 （实测应用设置页控件数从 93 暴涨到 1341） -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{DynamicResource BrushInputBg}"
                                                BorderBrush="{DynamicResource BrushInputBorder}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Path Width="9" Height="5" Margin="0,0,10,0"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Data="M0,0 L4.5,4.5 L9,0"
                                                  Stroke="{DynamicResource BrushFog}" StrokeThickness="1.5" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 只读态选中内容：DisplayMemberPath 生成的文本块不继承下拉框前景，
                                 暗色下呈系统默认黑字（用户实测）→ TextElement.Foreground 显式绑定 token -->
                            <ContentPresenter x:Name="ContentSite" Margin="10,0,26,0"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                <TextElement.Foreground>
                                    <DynamicResource ResourceKey="BrushText" />
                                </TextElement.Foreground>
                            </ContentPresenter>
                            <!-- 可编辑态（IsEditable）：PART_EditableTextBox 是 WPF 约定的部件名，
                                 缺失时键入内容不显示（第二轮账号下拉实测黑字/无回显的根因） -->
                            <TextBox x:Name="PART_EditableTextBox" Margin="8,0,26,0"
                                     VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource BrushText}"
                                     CaretBrush="{DynamicResource BrushText}"
                                     Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{DynamicResource BrushBg}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 次按钮（DashButton：磨砂白底 + 浅蓝描边 + 悬浮微上浮，规范 5.2） ===== -->
        <!-- 键盘焦点环（v2.2.1 可达性）：默认 FocusVisualStyle 是黑色虚线，暗色主题下不可辨。
             挂在各控件样式的 FocusVisualStyle 上——该机制只在键盘 Tab 进入时显示，鼠标点击不出现。 -->
        <Style x:Key="FocusRingVisual" TargetType="Control">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle RadiusX="12" RadiusY="12" Margin="-3"
                                   Stroke="{DynamicResource BrushPrimary}" StrokeThickness="1.5"
                                   StrokeDashArray="2 1.5" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Padding" Value="14,8" /> <!-- v2.2.0 第四轮：触摸目标 -->
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource BrushGlassStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusBtn}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" />
                                <Setter TargetName="Bd" Property="Margin" Value="0,-1,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主按钮（马卡龙渐变填充 + 白字，规范 5.2） ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource BrushBrandGradient}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusBtn}"
                                Padding="{TemplateBinding Padding}"
                                Effect="{DynamicResource ShadowPrimaryGlow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 危险按钮（蜜桃粉渐变 + 深红字，规范 5.2） ===== -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerDeep}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource BrushDangerGradient}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusBtn}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 行内小按钮（DataGrid 行操作 / 批量工具条；DashButton 紧凑变体） ===== -->
        <Style x:Key="RowActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Padding" Value="6,3" /> <!-- v2.2.0 第四轮：操作列压缩（280→200） -->
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource BrushInfoFg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{DynamicResource RadiusTag}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 行内危险动作（删除/断开/清空）：红色文字变体 -->
        <Style x:Key="RowActionButtonDanger" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerStrong}" />
        </Style>

        <!-- ===== 标题栏窗口按钮（规范 §9.1） ===== -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：悬浮转蜜桃粉 -->
        <Style x:Key="CaptionButtonDanger" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushDangerGradient}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushDangerDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框（颜色型）：不覆盖 ControlTemplate，只改配色 —— 自定义模板实测会让部分页面异常 -->
        <!-- v2.2.0 第三轮：密码框主题样式（此前裸 PasswordBox → 暗色下白底黑字刺眼） -->
        <Style x:Key="PasswordBoxSoft" TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                </Trigger>
            </Style.Triggers>
</Style>
        <Style x:Key="InputBoxSoft" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- v2.2.1 可达性：聚焦态边框高亮（此前聚焦与静态外观完全一致，
                 键盘 Tab 定位到输入框时无任何视觉反馈） -->
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                    <Setter Property="Background" Value="{DynamicResource BrushCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 页面标题（各页统一视觉层级） ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizePageTitle}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>

        <!-- ===== 统计数字（规范 5.1：大数字 + 小标签） ===== -->
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeStat}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
        </Style>

        <!-- ===== 表格（规范 5.4：宽松行距 + 极淡分割线 + 悬浮高亮） ===== -->
        <Style x:Key="SoftDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="40" /> <!-- v2.2.0 第五批：行高 38→40，单元格垂直居中与胶囊标签同基线 -->
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushSoftGradient}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BrushBgMist}" />
                        <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <!-- 单元格：选中态走 token（替代系统蓝），无默认网格线/焦点虚线框 -->
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushInfoBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 深浅主题自洽补齐（深色下系统默认滚动条/菜单/进度条是浅色件） ===== -->

        <!-- 滚动条滑块（竖横共用）：雾色细条，hover 加深，拖动转主色 -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" CornerRadius="4" Margin="1"
                                Background="{DynamicResource BrushFog}" Opacity="0.5" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushPrimary}" />
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 翻页按钮：透明占位（Track 的 Decrease/Increase 必备） -->
        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条（隐式）：纵向默认模板 + 横向触发器换模板 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="MinHeight" Value="8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 上下文菜单（隐式）：token 配色；方角 + 细边框（windowed popup 不支持圆角透明） -->
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource BrushBg}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                Padding="4">
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项（隐式）：本应用菜单均为扁平项（无子菜单/图标） -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <!-- Padding 10,8：此前 10,6 时分隔线几乎贴住上一项文字，看起来像「下划线错位」 -->
                        <!-- v2.2.0 第五批：可勾选菜单项（主题/模式）左侧留出勾选位，
                             选中项显示 ✓（状态型设置必须显示当前值，否则用户看不出当前主题/模式） -->
                        <Border x:Name="Bd" Background="Transparent" Padding="10,8" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark" Grid.Column="0" Text="✓" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource BrushPrimary}"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单分隔线（隐式）：v2.2.0 第四轮——线宽与菜单项文字对齐。
             此前 Separator 在 ContextMenu 的 StackPanel 中拉伸全宽，而 MenuItem 内容有
             Padding(10,8) 缩进 → 线比文字宽 20px，右端偏移（用户截图实证）。
             修法：模板内用 Border 包裹并施加与菜单项一致的左右 Padding(10,0)，
             使线宽 = 菜单内容宽，左右与文字对齐。 -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Padding="10,0">
                            <Border Background="{TemplateBinding Background}" Height="1" CornerRadius="0.5" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条（隐式）：轨道走 token，前景沿用绑定值（磁盘水位按等级着色） -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource BrushBgMist}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToolTip（隐式默认：全应用统一 token 配色） -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BrushBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusTag}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
