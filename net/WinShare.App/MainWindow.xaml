<Window x:Class="WinShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShare Panel"
        Width="1240" Height="820"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!--
      docs/UI_DESIGN.md §9 窗口风格化：无边框 + 磨砂玻璃自定义标题栏（左应用名 + 右最小化/最大化/关闭）。
      整体浅蓝调柔光渐变背板 + 16px 圆角外框；页面区承载各路由视图。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" CornerRadius="16" Background="{DynamicResource BrushAppBackdrop}"
            BorderBrush="{DynamicResource BrushGlassStroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#7EC8F0" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />
        </Border.Effect>

        <DockPanel>
            <!-- ===== 自定义标题栏（磨砂玻璃；可拖拽） ===== -->
            <Border DockPanel.Dock="Top" Height="52" CornerRadius="16,16,0,0"
                    Background="{DynamicResource BrushGlassStrong}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarDrag">
                <Grid Margin="18,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 品牌：渐变圆角方块 + 名称 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="9" Background="{DynamicResource BrushBrandGradient}">
                            <TextBlock Text="◈" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="WinShare Panel" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" />
                        <TextBlock x:Name="TitleStatus" Margin="12,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource BrushFog}" />
                    </StackPanel>

                    <!-- 快捷入口（替代原顶部菜单栏：同一批动作，不占版面） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="刷新" Style="{DynamicResource DashButton}" Margin="0,0,6,0" Click="OnMenuRefresh" ToolTip="F5" />
                        <Button Content="命令面板" Style="{DynamicResource DashButton}" Margin="0,0,6,0" Click="OnCommandPalette" ToolTip="Ctrl+K" />
                        <Button Content="更多" Style="{DynamicResource DashButton}" Click="OnTitleMoreClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="显示主窗口" Click="OnMenuShowWindow" />
                                    <MenuItem Header="打开日志文件夹" Click="OnMenuOpenLogDir" />
                                    <Separator />
                                    <MenuItem Header="浅色主题" Click="OnMenuThemeLight" />
                                    <MenuItem Header="深色主题" Click="OnMenuThemeDark" />
                                    <Separator />
                                    <MenuItem Header="关于" Click="OnMenuAbout" />
                                    <Separator />
                                    <MenuItem Header="退出" Click="OnMenuQuit" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- 窗口控制 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnMin" Width="34" Height="30" Content="—" Style="{DynamicResource CaptionButton}" Click="OnMinimize" />
                        <Button x:Name="BtnMax" Width="34" Height="30" Content="□" Style="{DynamicResource CaptionButton}" Click="OnMaximizeRestore" />
                        <Button x:Name="BtnClose" Width="34" Height="30" Content="✕" Style="{DynamicResource CaptionButtonDanger}" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 侧栏导航（通透磨砂；活跃项渐变 + 左侧指示条） ===== -->
            <Border DockPanel.Dock="Left" Width="216" CornerRadius="0,0,0,16"
                    Background="{DynamicResource BrushGlass}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,14">
                    <Button DockPanel.Dock="Bottom" Click="OnCommandPalette" Margin="0,10,0,0" Padding="10,8"
                            Style="{DynamicResource DashButton}" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Nav.CommandPalette}" Foreground="{DynamicResource BrushFog}" />
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource BrushFog}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ListView x:Name="NavList" BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="OnNavSelectionChanged" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,2,0,2" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Root" CornerRadius="12" Padding="10,9" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 活跃指示条（规范 5.3：左侧 3px 圆角渐变） -->
                                                    <Border x:Name="Indicator" Grid.Column="0" Width="3" CornerRadius="2"
                                                            Background="{DynamicResource BrushBrandGradient}"
                                                            Visibility="Collapsed" Margin="0,0,9,0" />
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                                    <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 图标用 Segoe MDL2 Assets（Windows 内置图标字体，避免 Unicode 符号缺字形显示成方块） -->
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Margin="0,0,12,0" Width="18"
                                               Foreground="{DynamicResource BrushPrimary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- ===== 页面区（承载各路由视图） ===== -->
            <Grid>
                <ContentControl x:Name="PageHost" Focusable="False" Background="Transparent" />

                <!-- 全屏加载遮罩（首次进入页面时的数据拉取：2-3s 的 PowerShell 5.1 调用不可避免，用动效承接） -->
                <Border x:Name="LoadingOverlay" Background="{DynamicResource BrushGlassStrong}" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <Ellipse Width="64" Height="64" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                            <Path x:Name="SpinnerArc" Stroke="{DynamicResource BrushPrimary}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 32,4 A 28,28 0 0 1 60,32">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate" CenterX="32" CenterY="32" />
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="LoadingText" Text="正在读取本机共享信息…" Margin="0,18,0,0"
                                   FontSize="13" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushFog}" />
                        <TextBlock Text="首次读取需要启动 Windows PowerShell，通常 2–3 秒" Margin="0,6,0,0"
                                   FontSize="11.5" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushFog}" Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
