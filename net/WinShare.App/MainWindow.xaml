<Window x:Class="WinShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShare Panel"
        Width="1240" Height="820"
        MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Resources/logo.png">
    <!--
      docs/UI_DESIGN.md §9 窗口风格化：无边框 + 磨砂玻璃自定义标题栏（左应用名 + 右最小化/最大化/关闭）。
      整体浅蓝调柔光渐变背板 + 16px 圆角外框；页面区承载各路由视图。
      v2.3 视觉重制：饱和科技蓝玻璃拟态——背板装饰光斑层 + 导航选中渐变胶囊 + 标题栏状态胶囊 + 底部状态栏。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- TextElement.Foreground：全应用“未显式着色”的文本继承主题字色，
         否则暗色下落到 WPF 默认纯黑（仪表盘卡片标题等） -->
    <Border x:Name="WindowFrame" CornerRadius="16" Background="{DynamicResource BrushAppBackdrop}"
            BorderBrush="{DynamicResource BrushGlassStroke}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource BrushText}">

        <!-- 装饰光斑层 + 内容层。ClipToBounds：光斑有意溢出边缘，裁切到窗口矩形即可，
             但绝不能触碰四角圆角区（Win10 无 DWM 圆角会露出方角色块）——光斑定位均离角 100px+ -->
        <Grid ClipToBounds="True">
            <!-- ===== 背景装饰（v2.3：光斑 + 细环，非交互；随主题 token 变色） ===== -->
            <Canvas IsHitTestVisible="False">
                <Ellipse Canvas.Right="-110" Canvas.Top="130" Width="380" Height="380"
                         Fill="{DynamicResource BrushDecorBlobA}" />
                <Ellipse Canvas.Left="-130" Canvas.Bottom="150" Width="400" Height="400"
                         Fill="{DynamicResource BrushDecorBlobB}" />
                <Ellipse Canvas.Right="150" Canvas.Top="96" Width="132" Height="132"
                         Stroke="{DynamicResource BrushPrimaryLight}" StrokeThickness="1.5" Opacity="0.35" />
                <Ellipse Canvas.Right="196" Canvas.Top="142" Width="40" Height="40"
                         Stroke="{DynamicResource BrushPrimaryLight}" StrokeThickness="1.5" Opacity="0.28" />
                <Ellipse Canvas.Left="240" Canvas.Bottom="64" Width="96" Height="96"
                         Stroke="{DynamicResource BrushSecondary}" StrokeThickness="1.5" Opacity="0.25" />
            </Canvas>

            <DockPanel>
                <!-- ===== 自定义标题栏（磨砂玻璃；可拖拽） ===== -->
                <Border DockPanel.Dock="Top" Height="52" CornerRadius="16,16,0,0"
                        Background="{DynamicResource BrushGlassStrong}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="OnTitleBarDrag">
                    <Grid Margin="18,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 品牌：统一 logo（仓库根 win-share-panel.png 派生）+ 名称 + 状态胶囊 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="26" Height="26" Source="Resources/logo.png" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="WinShare Panel" Margin="10,0,0,0" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushText}" />
                            <!-- v2.3：状态提示升级为"绿点 + 胶囊"（对齐参考稿"系统在线"）；
                                 文案仍由 SetStatusHint 驱动，异常态由代码切换胶囊配色 -->
                            <Border x:Name="TitleStatusPill" CornerRadius="10" Padding="9,3" Margin="12,0,0,0"
                                    Background="{DynamicResource BrushHueGreenSoft}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="TitleStatusDot" Width="7" Height="7" Fill="{DynamicResource BrushSuccess}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="TitleStatus" Margin="6,0,0,0" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushSuccess}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 快捷入口（替代原顶部菜单栏：同一批动作，不占版面） -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Content="刷新" Style="{DynamicResource DashButton}" Margin="0,0,6,0" Click="OnMenuRefresh" ToolTip="F5" />
                            <Button Content="命令面板" Style="{DynamicResource DashButton}" Margin="0,0,6,0" Click="OnCommandPalette" ToolTip="Ctrl+K" />
                            <Button Content="更多" Style="{DynamicResource DashButton}" Click="OnTitleMoreClick">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="显示主窗口" Click="OnMenuShowWindow" />
                                        <MenuItem Header="打开日志文件夹" Click="OnMenuOpenLogDir" />
                                        <Separator />
                                        <!-- v2.2.0 第五批：主题/模式为状态型设置 → 可勾选并显示当前值
                                             （此前是无状态的两条命令，用户看不出当前处于哪种主题/模式） -->
                                        <MenuItem x:Name="MenuThemeLight" Header="浅色主题" IsCheckable="True" Click="OnMenuThemeLight" />
                                        <MenuItem x:Name="MenuThemeDark" Header="深色主题" IsCheckable="True" Click="OnMenuThemeDark" />
                                        <Separator />
                                        <MenuItem x:Name="MenuModeNovice" Header="新手模式" IsCheckable="True" Click="OnMenuModeNovice" />
                                        <MenuItem x:Name="MenuModeExpert" Header="专家模式" IsCheckable="True" Click="OnMenuModeExpert" />
                                        <Separator />
                                        <MenuItem Header="关于" Click="OnMenuAbout" />
                                        <Separator />
                                        <MenuItem Header="退出" Click="OnMenuQuit" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <!-- 窗口控制 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnMin" Width="34" Height="30" Content="—" Style="{DynamicResource CaptionButton}" Click="OnMinimize" Focusable="False" />
                            <Button x:Name="BtnMax" Width="34" Height="30" Content="□" Style="{DynamicResource CaptionButton}" Click="OnMaximizeRestore" Focusable="False" />
                            <Button x:Name="BtnClose" Width="34" Height="30" Content="✕" Style="{DynamicResource CaptionButtonDanger}" Click="OnCloseClick" Focusable="False" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 非管理员提示条（v2.2.0：启动期检测；管理员身份下 Collapsed。提权入口与设置页共用 Elevation） -->
                <Border x:Name="AdminBanner" DockPanel.Dock="Top" Padding="18,7,10,7" Visibility="Collapsed"
                        Background="{DynamicResource BrushWarnBg}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushWarnDot}" Margin="0,0,9,0" />
                            <TextBlock Text="当前未以管理员身份运行：共享管理、协议配置、防火墙等操作将会失败。"
                                       FontSize="{DynamicResource FontSizeSecondary}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BrushWarnFg}" />
                            <Button Content="以管理员身份重启" Style="{DynamicResource DashButton}" Padding="10,5"
                                    Margin="14,0,0,0" VerticalAlignment="Center" Click="OnRelaunchAsAdmin" />
                        </StackPanel>
                        <Button Content="✕" Style="{DynamicResource DashButton}" Padding="6,2" FontSize="{DynamicResource FontSizeCaption}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="OnDismissAdminBanner" ToolTip="不再显示本次提醒" />
                    </Grid>
                </Border>

                <!-- ===== 底部状态栏（v2.3：对齐参考稿页脚——状态提示 + 标语 + 版本） ===== -->
                <Border DockPanel.Dock="Bottom" Height="34" CornerRadius="0,0,16,16"
                        Background="{DynamicResource BrushGlass}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                    <Grid Margin="18,0,18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Ellipse x:Name="FooterStatusDot" Width="7" Height="7" Fill="{DynamicResource BrushSuccess}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="FooterStatus" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center" Foreground="{DynamicResource BrushFog}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Footer.Slogan}" FontSize="{DynamicResource FontSizeCaption}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushFog}" Opacity="0.85" />
                        <TextBlock x:Name="FooterVersion" FontSize="{DynamicResource FontSizeCaption}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource BrushFog}" Opacity="0.85" />
                    </Grid>
                </Border>

                <!-- ===== 侧栏导航（通透磨砂；选中项=蓝色渐变胶囊白字，对齐参考稿） ===== -->
                <Border x:Name="NavRail" DockPanel.Dock="Left" Width="216" CornerRadius="0,0,0,16"
                        Background="{DynamicResource BrushGlass}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,18,14,14">
                        <Button DockPanel.Dock="Bottom" Click="OnCommandPalette" Margin="0,10,0,0" Padding="10,8"
                                Style="{DynamicResource DashButton}" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Nav.CommandPalette}" Foreground="{DynamicResource BrushFog}" />
                                <TextBlock Text="Ctrl+K" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource BrushFog}"
                                           Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ListView x:Name="NavList" BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="OnNavSelectionChanged" Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                    <Setter Property="Padding" Value="0" />
                                    <!-- 未选中=雾色（图标/文字统一绑定容器前景）；选中态触发器转白 -->
                                    <Setter Property="Foreground" Value="{DynamicResource BrushFog}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- v2.2.0 第五批：窄屏图标态下悬停必须给出页面名（否则图标不自解释） -->
                                    <Setter Property="ToolTip" Value="{Binding Title}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Root" CornerRadius="12" Padding="10,9" Background="Transparent">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushSoftGradient}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                    </Trigger>
                                                    <!-- 选中=渐变胶囊（放 hover 之后：两态叠加时选中外观优先） -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource BrushNavActiveGradient}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 图标用 Segoe MDL2 Assets（Windows 内置图标字体，避免 Unicode 符号缺字形显示成方块）；
                                             前景绑定容器（未选=雾色/悬停=字色/选中=白），随胶囊状态联动 -->
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Margin="0,0,12,0" Width="18"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="compact">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- ===== 页面区（承载各路由视图） ===== -->
                <Grid>
                    <ContentControl x:Name="PageHost" Focusable="False" Background="Transparent"
                                   HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

                    <!-- Toast 浮层（右下角；全局反馈通道 ToastHost） -->
                    <StackPanel x:Name="ToastLayer" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,18,18" Visibility="Collapsed" />

                    <!-- 全屏加载遮罩（首次进入页面时的数据拉取：2-3s 的 PowerShell 5.1 调用不可避免，用动效承接） -->
                    <Border x:Name="LoadingOverlay" Background="{DynamicResource BrushGlassStrong}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="64" Height="64" HorizontalAlignment="Center">
                                <Ellipse Width="64" Height="64" Stroke="{DynamicResource BrushBorder}" StrokeThickness="1" />
                                <Path x:Name="SpinnerArc" Stroke="{DynamicResource BrushPrimary}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 32,4 A 28,28 0 0 1 60,32">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotate" CenterX="32" CenterY="32" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="LoadingText" Text="正在读取本机共享信息…" Margin="0,18,0,0"
                                       FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushFog}" />
                            <TextBlock Text="首次读取需要调用 Windows PowerShell，通常数秒" Margin="0,6,0,0"
                                       FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource BrushFog}" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
