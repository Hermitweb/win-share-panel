<Window x:Class="WinShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShare Panel"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushBg}">
    <DockPanel>
        <!-- 主菜单（对齐 main.ts 菜单 + 托盘菜单面；Win11 DWM 背景在 code-behind 施加） -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource BrushCard}">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.ShowWindow}" Click="OnMenuShowWindow" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.OpenLogDir}" Click="OnMenuOpenLogDir" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Quit}" Click="OnMenuQuit" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.View}">
                <MenuItem Header="{DynamicResource Menu.ThemeLight}" Click="OnMenuThemeLight" />
                <MenuItem Header="{DynamicResource Menu.ThemeDark}" Click="OnMenuThemeDark" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Refresh}" Click="OnMenuRefresh"
                         InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem Header="{DynamicResource Menu.About}" Click="OnMenuAbout" />
            </MenuItem>
        </Menu>

        <!-- 侧栏导航（对齐 Layout.tsx aside w-56：6 路由 + 命令面板占位） -->
        <Border DockPanel.Dock="Left" Width="224" Background="{DynamicResource BrushCard}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <TextBlock DockPanel.Dock="Top" Text="WinShare Panel" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}" Margin="8,0,0,12" />
                <Button DockPanel.Dock="Bottom" Click="OnCommandPalette" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Nav.CommandPalette}" Foreground="{DynamicResource BrushFog}" />
                        <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource BrushFog}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ListView x:Name="NavList" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="OnNavSelectionChanged" Margin="0,0,0,8"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" FontSize="14" Margin="0,0,10,0"
                                           Foreground="{DynamicResource BrushPrimary}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.Resources>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Tag" Value="{Binding Route}" />
                        </Style>
                    </ListView.Resources>
                </ListView>
            </DockPanel>
        </Border>

        <!-- 页面区（ContentControl = 框架页宿主；占位页/仪表板都挂这里） -->
        <ContentControl x:Name="PageHost" Focusable="False"
                        Background="{DynamicResource BrushBg}" />
    </DockPanel>
</Window>
