<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      主题 token（浅色）——v2.3 视觉重制：饱和科技蓝玻璃拟态（参考"全平台总控"风格稿）。
      浅蓝渐变底 + 通透玻璃卡 + 蓝/紫/绿/橙四色 hue 徽章体系 + 饱和蓝主按钮与导航胶囊。
      页面一律用 {DynamicResource <Key>}，勿自造色值；深色字典须保持完全相同的键集。
    -->
    <!-- ===== 主色板 ===== -->
    <Color x:Key="ColorPrimary">#2E6FDE</Color> <!-- v2.3：#7EC8F0→饱和科技蓝（白底 4.7:1，文字/图形双达标） -->
    <Color x:Key="ColorPrimaryLight">#6FA3F0</Color>
    <Color x:Key="ColorSecondary">#8B7CE8</Color> <!-- v2.3：马卡龙淡紫→饱和紫罗兰 -->
    <Color x:Key="ColorSecondaryLight">#B0A6F2</Color>
    <Color x:Key="ColorAccent">#E85D75</Color> <!-- v2.3：淡粉→玫粉点缀 -->
    <Color x:Key="ColorAccentLight">#F597A8</Color>

    <!-- ===== 背景 / 文字 ===== -->
    <Color x:Key="ColorBg">#FFFFFF</Color>
    <Color x:Key="ColorBgMist">#ECF4FB</Color> <!-- v2.3：表头/轨道/分区底（比卡面灰一档承托层次） -->
    <Color x:Key="ColorInputBg">#E7EFF9</Color> <!-- 输入框底（比卡底灰一档） -->
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorText">#2F4159</Color> <!-- v2.3：加深为深海军蓝（白底 9:1+） -->
    <Color x:Key="ColorFog">#5E7488</Color> <!-- 保持 AA 4.5:1+（白底小字） -->
    <Color x:Key="ColorBorder">#DBE7F5</Color>
    <Color x:Key="ColorCheckBoxBorder">#A8C8DE</Color> <!-- 18px 未勾选框专用加深边框（取证值，勿回退） -->
    <Color x:Key="ColorChartBg">#EFF6FD</Color>

    <!-- ===== 语义色（沿用 AA 取证值，勿回退）===== -->
    <Color x:Key="ColorSuccess">#2E7D54</Color>
    <Color x:Key="ColorWarning">#F0C27B</Color>
    <Color x:Key="ColorDanger">#D9363E</Color>

    <!-- ===== 语义扩展（信息/警示标签与危险文本） ===== -->
    <Color x:Key="ColorInfoBg">#E6F4FF</Color>
    <Color x:Key="ColorInfoFg">#1677FF</Color>
    <Color x:Key="ColorWarnBg">#FFFBE6</Color>
    <Color x:Key="ColorWarnFg">#8F5400</Color>
    <Color x:Key="ColorWarnDot">#FAAD14</Color>
    <Color x:Key="ColorDangerStrong">#FF4D4F</Color>
    <Color x:Key="ColorDangerDeep">#A8071A</Color>

    <!-- ===== hue 四色体系（v2.3 新增：统计徽章 / 协议磁贴 / 装饰光斑） ===== -->
    <Color x:Key="ColorHueBlue">#3584EC</Color>
    <Color x:Key="ColorHuePurple">#8B5CF6</Color>
    <Color x:Key="ColorHueGreen">#1FA97C</Color>
    <Color x:Key="ColorHueOrange">#F08C1A</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushBgMist" Color="{StaticResource ColorBgMist}" />
    <SolidColorBrush x:Key="BrushInputBg" Color="{StaticResource ColorInputBg}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushFog" Color="{StaticResource ColorFog}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushCheckBoxBorder" Color="{StaticResource ColorCheckBoxBorder}" />
    <!-- v2.2.0 第五批：输入框边框对比 3.59:1（WCAG 1.4.11 ≥3:1 取证值，勿回退） -->
    <SolidColorBrush x:Key="BrushInputBorder" Color="#6E8AA6" />
    <SolidColorBrush x:Key="BrushChartBg" Color="{StaticResource ColorChartBg}" />
    <SolidColorBrush x:Key="BrushInfoBg" Color="{StaticResource ColorInfoBg}" />
    <SolidColorBrush x:Key="BrushInfoFg" Color="{StaticResource ColorInfoFg}" />
    <SolidColorBrush x:Key="BrushWarnBg" Color="{StaticResource ColorWarnBg}" />
    <SolidColorBrush x:Key="BrushWarnFg" Color="{StaticResource ColorWarnFg}" />
    <SolidColorBrush x:Key="BrushWarnDot" Color="{StaticResource ColorWarnDot}" />
    <SolidColorBrush x:Key="BrushDangerStrong" Color="{StaticResource ColorDangerStrong}" />
    <SolidColorBrush x:Key="BrushDangerDeep" Color="{StaticResource ColorDangerDeep}" />

    <!-- hue 实色 / 柔和衬底（标签、芯片、磁贴底） -->
    <SolidColorBrush x:Key="BrushHueBlue" Color="{StaticResource ColorHueBlue}" />
    <SolidColorBrush x:Key="BrushHuePurple" Color="{StaticResource ColorHuePurple}" />
    <SolidColorBrush x:Key="BrushHueGreen" Color="{StaticResource ColorHueGreen}" />
    <SolidColorBrush x:Key="BrushHueOrange" Color="{StaticResource ColorHueOrange}" />
    <SolidColorBrush x:Key="BrushHueBlueSoft" Color="#E4F0FE" />
    <SolidColorBrush x:Key="BrushHuePurpleSoft" Color="#F0EBFE" />
    <SolidColorBrush x:Key="BrushHueGreenSoft" Color="#E2F7EF" />
    <SolidColorBrush x:Key="BrushHueOrangeSoft" Color="#FEF1E0" />

    <!-- 遮罩（弹层/抽屉底衬；主题间同值） -->
    <SolidColorBrush x:Key="BrushOverlayScrim" Color="#000000" Opacity="0.25" />

    <!-- ===== 磨砂玻璃 / 渐变 ===== -->
    <SolidColorBrush x:Key="BrushGlass" Color="#FFFFFF" Opacity="0.50" />
    <SolidColorBrush x:Key="BrushGlassStrong" Color="#FFFFFF" Opacity="0.66" />
    <SolidColorBrush x:Key="BrushGlassStroke" Color="#FFFFFF" Opacity="0.60" />
    <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <!-- v2.3：马卡龙三色→饱和蓝（全渐变段对白字 ≥3.6:1） -->
        <GradientStop Color="#3584EC" Offset="0" />
        <GradientStop Color="#2456D6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushSoftGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3F0FD" Offset="0" />
        <GradientStop Color="#EDEBFB" Offset="1" />
    </LinearGradientBrush>
    <!-- 卡面纵向玻璃渐变（v2.3 四轮：顶部实白高光 → 底部半透，光斑透出，空间感） -->
    <LinearGradientBrush x:Key="BrushCardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFFFFFF" Offset="0" />
        <GradientStop Color="#E6FFFFFF" Offset="0.55" />
        <GradientStop Color="#D8FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 玻璃边缘渐变（顶亮底暗，伪玻璃边——替代 DropShadowEffect 的深度暗示） -->
    <LinearGradientBrush x:Key="BrushGlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0" />
        <GradientStop Color="#59FFFFFF" Offset="0.5" />
        <GradientStop Color="#3394A3B8" Offset="1" />
    </LinearGradientBrush>
    <!-- 页面氛围背景：亮而不白——中心近白、边缘留柔和蓝调承托光斑与卡片层次
         （v2.3 二轮：纯白版「太亮、空间感被覆盖」，回调至中间调） -->
    <LinearGradientBrush x:Key="BrushAppBackdrop" StartPoint="0,0" EndPoint="1,1">
        <!-- v2.3 三轮：再压低亮度、加深边缘蓝调（用户反馈"再低点亮度、多点空间感"） -->
        <GradientStop Color="#E3EFFA" Offset="0" />
        <GradientStop Color="#F3F9FF" Offset="0.45" />
        <GradientStop Color="#E8F1FA" Offset="1" />
    </LinearGradientBrush>
    <!-- 导航选中胶囊（v2.3 新增；渐变段对白字 ≥4.5:1——导航为常显小字，按正文对比取值） -->
    <LinearGradientBrush x:Key="BrushNavActiveGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#306EE8" Offset="0" />
        <GradientStop Color="#2350C8" Offset="1" />
    </LinearGradientBrush>
    <!-- Hero 横幅底（v2.3 新增：蓝→紫玻璃渐变；提亮变体） -->
    <LinearGradientBrush x:Key="BrushHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F2FE" Offset="0" />
        <GradientStop Color="#F5F1FE" Offset="1" />
    </LinearGradientBrush>
    <!-- hue 渐变磁贴（v2.3 新增：徽章/协议卡图标配底，白色字形） -->
    <LinearGradientBrush x:Key="BrushHueBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4D97F5" Offset="0" />
        <GradientStop Color="#2E6FE0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushHuePurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0" />
        <GradientStop Color="#7C4DE8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushHueGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#34C08D" Offset="0" />
        <GradientStop Color="#0E9E6E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushHueOrangeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB25C" Offset="0" />
        <GradientStop Color="#EF8412" Offset="1" />
    </LinearGradientBrush>
    <!-- 背景装饰光斑（v2.3 四轮：更大更透，多层纵深；卡片半透后光斑透出形成玻璃感） -->
    <SolidColorBrush x:Key="BrushDecorBlobA" Color="#9ECDF9" Opacity="0.5" />
    <SolidColorBrush x:Key="BrushDecorBlobB" Color="#C3AEF6" Opacity="0.42" />
    <SolidColorBrush x:Key="BrushDecorBlobC" Color="#8FD8E8" Opacity="0.35" />
    <!-- 危险按钮渐变 -->
    <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F5C6C6" Offset="0" />
        <GradientStop Color="#F0A8A8" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== 柔光弥散阴影 ===== -->
    <DropShadowEffect x:Key="ShadowCard" Color="#7EC8F0" Opacity="0.12" BlurRadius="16" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="ShadowHover" Color="#7EC8F0" Opacity="0.20" BlurRadius="28" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="ShadowSoft" Color="#3A4A5C" Opacity="0.04" BlurRadius="3" ShadowDepth="1" Direction="270" />
    <!-- 主按钮辉光（v2.3 新增：替换 App.xaml 内硬编码色） -->
    <DropShadowEffect x:Key="ShadowPrimaryGlow" Color="#2E6FDE" Opacity="0.35" BlurRadius="14" ShadowDepth="2" Direction="270" />
    <!-- 无边框主窗口外辉光（浅色=品牌蓝柔光） -->
    <DropShadowEffect x:Key="ShadowWindowGlow" Color="#7EC8F0" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />

    <!-- ===== 间距 / 字号 ===== -->
    <sys:Double x:Key="SpacingSm">12</sys:Double>
    <sys:Double x:Key="SpacingMd">16</sys:Double>
    <sys:Double x:Key="SpacingLg">24</sys:Double>
    <sys:Double x:Key="SpacingXl">32</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeStat">30</sys:Double>

    <!-- ===== 圆角（卡片 16 / 按钮 12 / 输入 10 / 标签 8） ===== -->
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusBtn">12</CornerRadius>
    <CornerRadius x:Key="RadiusInput">10</CornerRadius>
    <CornerRadius x:Key="RadiusTag">8</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
</ResourceDictionary>
