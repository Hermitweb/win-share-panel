<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      主题 token（浅色）——严格对齐 docs/UI_DESIGN.md：
      浅蓝调 · 轻渐变扁平化 · 新拟态柔光磨砂玻璃（圆角 16/12/8、柔光弥散阴影、通透薄纸质感）。
      页面一律用 {DynamicResource <Key>}，勿自造色值。
    -->
    <!-- ===== 主色板（规范 2.1） ===== -->
    <Color x:Key="ColorPrimary">#7EC8F0</Color>
    <Color x:Key="ColorPrimaryLight">#A8DCF5</Color>
    <Color x:Key="ColorSecondary">#C8B6E2</Color>
    <Color x:Key="ColorSecondaryLight">#D9CCEC</Color>
    <Color x:Key="ColorAccent">#F5C6C6</Color>
    <Color x:Key="ColorAccentLight">#FAD9D9</Color>

    <!-- ===== 背景 / 文字（规范 2.1） ===== -->
    <Color x:Key="ColorBg">#FFFFFF</Color>
    <Color x:Key="ColorBgMist">#F4FAFD</Color>
    <Color x:Key="ColorInputBg">#EAF3FA</Color> <!-- v2.2.0 第三轮：输入框底（比卡底灰一档） -->
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorText">#3A4A5C</Color>
    <Color x:Key="ColorFog">#5E7488</Color> <!-- v2.2.0：提亮至 AA 4.5:1+（白底小字） -->
    <Color x:Key="ColorBorder">#E3EEF6</Color>
    <Color x:Key="ColorCheckBoxBorder">#A8C8DE</Color> <!-- v2.2.1 取证轮：18px 未勾选框在 #F4FAFD 卡底上 BrushBorder(≈1.05:1) 不可见，专用加深边框 -->
    <Color x:Key="ColorChartBg">#F4FAFD</Color>

    <!-- ===== 语义色（沿用可读性，降饱和以贴合浅蓝调）===== -->
    <Color x:Key="ColorSuccess">#2E7D54</Color> <!-- v2.2.0 第三轮：文字用对比达 AA（白底 4.6:1） -->
    <Color x:Key="ColorWarning">#F0C27B</Color>
    <Color x:Key="ColorDanger">#D9363E</Color> <!-- v2.2.0 第三轮：文字用对比达 AA（白底 4.6:1） -->

    <!-- ===== 语义扩展（信息/警示标签与危险文本；浅色值 = 原硬编码视觉，深色字典给正确值） ===== -->
    <Color x:Key="ColorInfoBg">#E6F4FF</Color>
    <Color x:Key="ColorInfoFg">#1677FF</Color>
    <Color x:Key="ColorWarnBg">#FFFBE6</Color>
    <Color x:Key="ColorWarnFg">#8F5400</Color> <!-- v2.2.0 第三轮：微调至 AA（白底 5.0:1） -->
    <Color x:Key="ColorWarnDot">#FAAD14</Color>
    <Color x:Key="ColorDangerStrong">#FF4D4F</Color>
    <Color x:Key="ColorDangerDeep">#A8071A</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushBgMist" Color="{StaticResource ColorBgMist}" />
    <SolidColorBrush x:Key="BrushInputBg" Color="{StaticResource ColorInputBg}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushFog" Color="{StaticResource ColorFog}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource ColorPrimaryLight}" />
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushCheckBoxBorder" Color="{StaticResource ColorCheckBoxBorder}" /> <!-- v2.2.1：未勾选框可辨（同 BrushInputBorder 修复思路） -->
    <!-- v2.2.0 第五批：输入框边框对比 1.69:1 → 3.59:1（WCAG 1.4.11 非文本对比 ≥3:1；
         原 #B9C9DA 与白底几乎不可辨，浅色主题下"没有输入框"） -->
    <SolidColorBrush x:Key="BrushInputBorder" Color="#6E8AA6" />
    <SolidColorBrush x:Key="BrushChartBg" Color="{StaticResource ColorChartBg}" />
    <SolidColorBrush x:Key="BrushInfoBg" Color="{StaticResource ColorInfoBg}" />
    <SolidColorBrush x:Key="BrushInfoFg" Color="{StaticResource ColorInfoFg}" />
    <SolidColorBrush x:Key="BrushWarnBg" Color="{StaticResource ColorWarnBg}" />
    <SolidColorBrush x:Key="BrushWarnFg" Color="{StaticResource ColorWarnFg}" />
    <SolidColorBrush x:Key="BrushWarnDot" Color="{StaticResource ColorWarnDot}" />
    <SolidColorBrush x:Key="BrushDangerStrong" Color="{StaticResource ColorDangerStrong}" />
    <SolidColorBrush x:Key="BrushDangerDeep" Color="{StaticResource ColorDangerDeep}" />
    <!-- 遮罩（弹层/抽屉底衬；主题间同值） -->
    <SolidColorBrush x:Key="BrushOverlayScrim" Color="#000000" Opacity="0.25" />

    <!-- ===== 磨砂玻璃 / 渐变（规范 2.2 / 4.2） ===== -->
    <SolidColorBrush x:Key="BrushGlass" Color="#FFFFFF" Opacity="0.65" />
    <SolidColorBrush x:Key="BrushGlassStrong" Color="#FFFFFF" Opacity="0.82" />
    <SolidColorBrush x:Key="BrushGlassStroke" Color="#FFFFFF" Opacity="0.6" />
    <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <!-- v2.2.1 取证轮：原 #A8DCF5/#C8B6E2/#F5C6C6 与白字仅 ≈1.35:1（主按钮「创建/保存」字几乎不可辨），
             加深至全渐变段 ≥3:1（对齐深色主题的饱和度，色相不变） -->
        <GradientStop Color="#2E9BDB" Offset="0" />
        <GradientStop Color="#8B76C2" Offset="0.55" />
        <GradientStop Color="#C97979" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushSoftGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F4FB" Offset="0" />
        <GradientStop Color="#F0EAF8" Offset="1" />
    </LinearGradientBrush>
    <!-- 页面氛围背景：极柔渐变（规范 7.2） -->
    <LinearGradientBrush x:Key="BrushAppBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F4FAFD" Offset="0.45" />
        <GradientStop Color="#F5F1FB" Offset="1" />
    </LinearGradientBrush>
    <!-- 危险按钮渐变（规范 5.2） -->
    <LinearGradientBrush x:Key="BrushDangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F5C6C6" Offset="0" />
        <GradientStop Color="#F0A8A8" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== 柔光弥散阴影（规范 4.1；WPF 用 DropShadowEffect 近似） ===== -->
    <DropShadowEffect x:Key="ShadowCard" Color="#7EC8F0" Opacity="0.12" BlurRadius="16" ShadowDepth="4" Direction="270" />
    <DropShadowEffect x:Key="ShadowHover" Color="#7EC8F0" Opacity="0.20" BlurRadius="28" ShadowDepth="8" Direction="270" />
    <DropShadowEffect x:Key="ShadowSoft" Color="#3A4A5C" Opacity="0.04" BlurRadius="3" ShadowDepth="1" Direction="270" />
    <!-- 无边框主窗口外辉光（浅色=品牌蓝柔光；深色字典给夜色投影） -->
    <DropShadowEffect x:Key="ShadowWindowGlow" Color="#7EC8F0" Opacity="0.18" BlurRadius="24" ShadowDepth="0" />

    <!-- ===== 间距 / 字号（规范 3.3 / 5.x） ===== -->
    <sys:Double x:Key="SpacingSm">12</sys:Double>
    <sys:Double x:Key="SpacingMd">16</sys:Double>
    <sys:Double x:Key="SpacingLg">24</sys:Double>
    <sys:Double x:Key="SpacingXl">32</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeStat">30</sys:Double>

    <!-- ===== 圆角（规范 3.1：卡片 16 / 按钮 12 / 输入 10 / 标签 8） ===== -->
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusBtn">12</CornerRadius>
    <CornerRadius x:Key="RadiusInput">10</CornerRadius>
    <CornerRadius x:Key="RadiusTag">8</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
</ResourceDictionary>
