<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
      主题 token（浅色）：色板对齐 antd 默认 palette 与 TS 版 index.css 变量（chart-bg 取 #F4FAFD）。
      间距 8/16/24、字号 12/14/16/20、圆角 6，antd 视觉密度。
      T3b/c/d 页面直接使用这些 DynamicResource，勿自造色值。
    -->
    <Color x:Key="ColorBg">#F4FAFD</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorText">#1F2733</Color>
    <Color x:Key="ColorFog">#731F2733</Color>
    <Color x:Key="ColorPrimary">#1677FF</Color>
    <Color x:Key="ColorSuccess">#52C41A</Color>
    <Color x:Key="ColorWarning">#FAAD14</Color>
    <Color x:Key="ColorDanger">#FF4D4F</Color>
    <Color x:Key="ColorBorder">#E4E9F0</Color>
    <Color x:Key="ColorChartBg">#F4FAFD</Color>

    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushFog" Color="{StaticResource ColorFog}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushChartBg" Color="{StaticResource ColorChartBg}" />

    <sys:Double x:Key="SpacingSm">8</sys:Double>
    <sys:Double x:Key="SpacingMd">16</sys:Double>
    <sys:Double x:Key="SpacingLg">24</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">16</sys:Double>
    <sys:Double x:Key="FontSizeStat">28</sys:Double>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusBtn">6</CornerRadius>
</ResourceDictionary>
